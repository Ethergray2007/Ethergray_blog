# 构建产物
dist/

# Astro 生成的类型
.astro/

# 依赖
node_modules/

# 环境变量（里面有数据库密码和登录密钥，绝不能提交）
.env
.env.production

# Pagefind 搜索索引（每次构建重新生成）
public/pagefind

# Netlify 本地构建目录
.netlify

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 操作系统/编辑器产生的杂项
.DS_Store
.idea/

# 工具临时目录（DSH harness 调试时会产生）
.dsh-probe/

# 本项目专用的 npm 缓存（避免写全局缓存目录，也避免误提交）
.npm-cache/
