# 构建产物
dist/

# Astro 生成的类型
.astro/

# 依赖
node_modules/

# 环境变量（里面有数据库密码和登录密钥，绝不能提交）
#
# .env.local / .env.*.local 是各框架约定俗成的"本地覆盖"文件，
# 优先级**比 .env 高** —— 也就是说密钥更可能落在这些文件里。
# 之前只挡了 .env 和 .env.production，这两个漏在外面。
#
# ⚠️ 不能图省事写成 .env* —— .env.example 是给人看的模板，
#    必须留在仓库里。
.env
.env.local
.env.*.local
.env.production

# Pagefind 搜索索引（每次构建重新生成）
public/pagefind

# Netlify 本地构建目录
.netlify

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 操作系统/编辑器产生的杂项
.DS_Store
.idea/

# 工具临时目录（DSH harness 调试时会产生）
.dsh-probe/
# 调试时截的页面截图，不是项目内容
.dsh-shots/

# Playwright 下载的无头浏览器（约 120 MB）和它截的图。
#
# ⚠️ 浏览器本体只能放在项目内：这台机器的沙箱不允许写
#    %LOCALAPPDATA%\ms-playwright，默认路径会直接 spawn EPERM。
#    所以用 PLAYWRIGHT_BROWSERS_PATH 指到项目里 —— 但这样就**必须**
#    挡住它，否则一次 git add -A 就是一百多兆的二进制进仓库。
.playwright-browsers/
practice/_shots/

# 本项目专用的 npm 缓存（避免写全局缓存目录，也避免误提交）
.npm-cache/

# 首屏背景图的**原图**（约 6 MB，本地素材，不进仓库）
# 成品是 public/hero-bg.jpg（约 108 KB，已提交）
# 想换图：把新图放到这个位置，然后跑 node scripts/make-hero-bg.ts
src/assets/images/hero-bg.png

# 一次性探索脚本（下划线开头 = 用完即删，不进仓库）
# 约定：在 practice/ 下临时写的验证脚本都用 _ 开头，
# 这样无论起什么名字都不会被误提交。
practice/_*

# archify（画架构图技能）的中间产物，不是项目内容
.archify/

# 临时调研 / 验证目录
#
# 和 practice/_* 是同一个约定：**临时写的东西不进仓库**。
# 但这次是新起的目录名，所以要在两处都登记（少一处就漏）：
#   .gitignore            从源头不跟踪
#   eslint.config.js      否则 npx eslint . 会把里面的 console.log 当错误
#
# ⚠️ ESLint 的 ignores 是显式列表，它**不读 .gitignore** ——
#    只加这里是不够的。这个坑踩过一次。
code-review/
.diag/

# 根目录下的下划线项（临时快照 / 调研目录：_audit/、_walkthrough/、_probe_fqzlr/）
#
# 与其一个个登记目录名（列举法永远会漏，上面那条 code-review/ 就是它的产物），
# 不如按 practice/_* 那个约定统一挡掉：**根目录下划线开头 = 临时东西**。
# 这和 scripts/commit-check.ts 里的 /^_/ 是同一条政策，只是一边拦在源头、
# 一边拦在提交前。
#
# ⚠️ 开头的 `/` 不能省。两个写法只差一个字符，后果完全不同：
#   /_*   只匹配**仓库根目录**下的下划线项            ← 要的是这个
#   _*/   按**任意层级**匹配，src/pages 下的 _components/ 也会被忽略
# 而 _components/ 是**正式目录**（下划线在那里表示"不是路由"）。
# 同一个符号两种含义，只能靠锚定区分。
#
# 实测代价：这三个目录既没被忽略、又被 eslint 扫到，
# `npx eslint .` 报 787 个 no-console 错 —— 第 3 道检查一直是红的。
/_*

# AgentTeams 的团队状态（team.json + 各成员 inbox/*.jsonl）
#
# 它是 DSH 运行时的**状态文件**，不是项目内容 —— 里面记的是
# 某个会话里谁认领了哪个任务，人和事都过期了，进仓库只会是噪音。
# 而且 team.json 动辄 70 KB 以上，多来几轮评审就更大。
.agent-teams/

