# .env 里需要填的东西（复制成 .env 再改）
# ============================================================
# 这个文件是模板，会被提交到 git。
# 真正存放密钥的 .env 不会被提交（已在 .gitignore 里）。
#
# 复制方式：
#   Copy-Item .env.example .env
# 然后用编辑器把下面每一项填上。

# ------------------------------------------------------------
# 数据库
# ------------------------------------------------------------

# 从 Neon 控制台的 Dashboard → Connection string 复制。
# 形如：
#   postgresql://用户名:密码@ep-xxx-pooler.区域.aws.neon.tech/neondb?sslmode=require
#
# ⚠️ 主机名里要带 -pooler（连接池版本）。Serverless 环境下直连很容易
#    把数据库的连接数用满。
# ⚠️ 这串里有数据库密码，不要发给任何人。
DATABASE_URL=

# ------------------------------------------------------------
# 文章改动后自动重新构建
# ------------------------------------------------------------
# 文章存在数据库里，而页面是**构建时**生成的静态 HTML，
# 所以后台保存文章之后要让 Netlify 重新构建一次，改动才会出现在站点上。
#
# 怎么拿这个地址：
#   Netlify 后台 → Site configuration → Build & deploy → Build hooks
#   新建一个（名字随便，比如 "文章更新"），复制它给出的 URL
#
# 不填也能用 —— 只是改完文章要等下一次推送代码才生效，
# 后台保存时会记一条日志说"跳过自动重建"。
# ⚠️ 这个地址带密钥（谁拿到都能触发构建），不要发出去。
NETLIFY_BUILD_HOOK_URL=

# ------------------------------------------------------------
# 登录（GitHub OAuth）
# ------------------------------------------------------------
# 登录不需要密码 —— 用你的 GitHub 账号登录。
# 数据库里因此不用存任何用户信息，也就没有"密码泄露"这回事。

# 1. 打开 https://github.com/settings/developers
# 2. 点 "New OAuth App"，填：
#      Application name           随便填，比如 ethergray-blog
#      Homepage URL               http://localhost:4321
#      Authorization callback URL http://localhost:4321/api/session/callback/github
# 3. 创建后复制 Client ID，再点 "Generate a new client secret" 复制密钥
#
# ⚠️ GitHub 要求回调地址**完全匹配**，所以线上要另外建一个 App，
#    回调地址填 https://你的域名/api/session/callback/github
#    （本地和线上各一个 App，互不影响）

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 只允许这个 GitHub 用户 id 登录 —— 别人即使完成了授权也进不来。
#
# 怎么查：访问 https://api.github.com/users/你的用户名
# 响应里的 "id" 字段就是，是个数字。
#
# ⚠️ 填 id 而不是用户名。用户名可以改，改了你就登不进来了。
GITHUB_OWNER_ID=

# 会话加密用的密钥，至少 32 个字符。
# 生成方法：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️ 拿到它就能伪造登录状态。不要用短密码，不要复用别的密码。
BETTER_AUTH_SECRET=

# 服务自身的地址。本地开发不用填（默认 http://localhost:4321），
# 线上由 Netlify 自动注入 URL 变量，通常也不用填。
# 只有在用自定义域名、而 Netlify 的 URL 变量不对时才需要手动指定。
# BETTER_AUTH_URL=https://你的域名
