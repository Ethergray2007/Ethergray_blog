---
/**
 * 设计实验室  /design-lab
 * ============================================================
 * 用 [ak-ui](https://ak-ui.yyj.moe) 的令牌和组件搭的参考页。
 * 用途：看清这套设计语言有哪些东西、实际长什么样、怎么接进项目。
 *
 * 【为什么用 ak-ui 而不是自己写】
 * 一开始我是手写 CSS 的，然后发现三件事：
 *   1. ak-ui 是纯 CSS、零依赖、114 个组件类，而且能按需引入 ——
 *      比手写的那几十行完整得多
 *   2. 它有一整套语义令牌命名（--ak-surface-panel / --ak-signal-action …），
 *      手写的没有这层，颜色一多就乱
 *   3. 手写版违反了它的三条明确规则：不该改 :root、不该引全局 reset、
 *      应该把品牌色**映射**到语义角色而不是覆盖掉
 *
 * 【样式强度：accent】
 * ak-ui 定义了三档强度：
 *   accent    保留现有品牌和布局，只加信号色、排版、焦点、克制的几何
 *   system    完整设计语言（默认）
 *   terminal  沉浸式布局，会改变页面结构
 *
 * 这里选 accent —— 因为这是接进一个已有博客，不是从零做产品。
 * 目标不是"看起来像个游戏界面"，而是"用工业编辑式的秩序感组织信息"。
 *
 * 【刻意不做的事】
 * ak-ui 的文档专门列了失败模式，其中两条最容易犯：
 *   · 黑底 + 青边 + 到处发光
 *   · 为了"氛围"编造无意义的读数（假帧率、假编号）
 * 所以这一页：
 *   · 不编造任何数据。能展示真实信息的地方就用真实信息
 *     （构建时间、文件数、真实文章的元数据）
 *   · 不把每个元素都切角、不整页大写、不整页等宽
 *   · 强调色只用在"信号"上，不做背景装饰
 *
 * 【不进导航、不进 sitemap、不进搜索索引】
 * 它是工作台，不是内容页。页面里有 noindex，sitemap 也排除了。
 *
 * 想删掉？
 *   1. 删掉这个文件
 *   2. 卸载依赖：npm uninstall @yunyoujun/ak-ui
 *   3. 删掉 astro.config.ts 里 sitemap 排除 design-lab 的那条规则
 *   4. 删掉 README 的「可选模块」表里那一行
 * ============================================================
 */
import config from "@/config";

/**
 * ⚠️ 这里**故意只引 ak-ui**，不引 global.css。
 *
 * 原因：global.css 会拉起 Tailwind + DaisyUI 的完整基础层，
 * 而这一页只想演示 ak-ui 本身。两套基础层叠在一起，
 * 既看不出 ak-ui 原本的样子，也不好判断谁在起作用。
 *
 * 代价：这一页用不了 Tailwind 的工具类（flex / mt-4 之类）。
 * 布局改用 ak-ui 自己的类 + 少量内联样式 —— 对演示页来说够用。
 *
 * 页面级 token 覆盖写在下面的 <style> 里，**作用域限定在这一页**，
 * 不碰 :root，所以不会影响博客的任何其他页面。
 */
import "@yunyoujun/ak-ui/style.css";

const locale = Astro.currentLocale ?? config.site.lang;

/**
 * 令牌分组展示。
 * 每条都写清"用在什么场景"—— 令牌列表如果只列名字，
 * 看的人不知道该用哪个，等于没写。
 */
const tokenGroups = [
  {
    title: "表面 / Surface",
    note: "从画布到抬起，四层足够。层级靠明度差，不要靠边框堆叠。",
    tokens: [
      ["--ak-surface-canvas", "页面画布"],
      ["--ak-surface-panel", "浅色面板（纸感）"],
      ["--ak-surface-muted", "安静面板"],
      ["--ak-surface-raised", "抬起/深色面板"],
    ],
  },
  {
    title: "文字 / Text",
    note: "两档正文 + 一档反色，不要再细分。",
    tokens: [
      ["--ak-text-primary", "主文字"],
      ["--ak-text-secondary", "次要文字"],
      ["--ak-text-inverse", "浅色表面上的字"],
    ],
  },
  {
    title: "信号 / Signal",
    note: "每个信号色有固定含义。不要为了好看挪用语义。",
    tokens: [
      ["--ak-signal-info", "信息"],
      ["--ak-signal-action", "动作 / 警告"],
      ["--ak-signal-accent", "集中强调"],
      ["--ak-signal-success", "成功"],
      ["--ak-signal-danger", "危险"],
    ],
  },
  {
    title: "几何 / Geometry",
    note: "切角分三档。整页只该有一处强几何，其余保持方正。",
    tokens: [
      ["--ak-cut-sm", "小切角"],
      ["--ak-cut-md", "中切角"],
      ["--ak-cut-lg", "大切角"],
      ["--ak-line-hairline", "细线"],
      ["--ak-line-strong", "粗线"],
    ],
  },
  {
    title: "动效 / Motion",
    note: "三档时长 + 两条缓动曲线。悬停用 fast，进场用 slow。",
    tokens: [
      ["--ak-motion-fast", "悬停反馈"],
      ["--ak-motion-base", "状态变化"],
      ["--ak-motion-slow", "进场"],
      ["--ak-ease-standard", "标准缓动"],
      ["--ak-ease-emphasized", "强调缓动"],
    ],
  },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>设计实验室 | {config.site.title}</title>
    <meta
      name="description"
      content="ak-ui 设计语言的令牌与组件参考页，供项目内部使用。"
    />
  </head>

  <body>
    <main class="ak-lab">
      {
        /* ============================================================
          页头
          ============================================================ */
      }
      <header class="ak-lab__head">
        <p class="ak-lab__eyebrow">
          Design Reference &nbsp;/&nbsp; ak-ui v1.1.0
        </p>

        <h1 class="ak-lab__title">工业编辑式界面</h1>

        <p class="ak-lab__lead">
          用 ak-ui 的令牌和组件搭的参考页。风格强度选的是
          <strong>accent</strong> —— 保留现有品牌与布局，只加上信号色、 强命令排版、可见焦点和克制的几何。
        </p>

        <p class="ak-lab__note">
          这一页不编造数据。下面的所有数字都来自这个仓库的真实状态。
        </p>
      </header>

      {
        /* ============================================================
          1. 按钮 —— 顺带把所有交互状态摆出来
          ============================================================ */
      }
      <section class="ak-lab__section">
        <h2 class="ak-lab__h2">按钮与状态</h2>
        <p class="ak-lab__desc">
          ak-ui 的按钮是固定尺寸（150×50），文字放在
          <code>.ak-button__label</code> 里。 交互反馈同时改变<b>位移</b>和<b
            >明度</b
          > —— 不只靠颜色。
        </p>

        <div class="ak-lab__row">
          <button class="ak-button" type="button">
            <span class="ak-button__label">默认</span>
          </button>

          <button class="ak-button ak-button--action" type="button">
            <span class="ak-button__label">主要动作</span>
          </button>

          <button class="ak-button ak-button--outline" type="button">
            <span class="ak-button__label">描边</span>
          </button>

          <button class="ak-button ak-button--advanced" type="button">
            <span class="ak-button__label">强调</span>
          </button>

          <button class="ak-button" type="button" disabled>
            <span class="ak-button__label">禁用</span>
          </button>
        </div>

        <p class="ak-lab__hint">
          试着用 <kbd>Tab</kbd> 键在按钮之间移动 —— 焦点必须看得见，而且不能被裁剪掉。
        </p>
      </section>

      {
        /* ============================================================
          2. 排版 —— 三种字体对应三种信息角色
          ============================================================ */
      }
      <section class="ak-lab__section">
        <h2 class="ak-lab__h2">排版三层</h2>
        <p class="ak-lab__desc">
          衬线承担命令和标题，无衬线承担正文和控件，等宽承担编号和数值。
          中英混排时，英文负责节奏，中文负责语义 —— 英文不是翻译。
        </p>

        <div class="ak-lab__grid ak-lab__grid--3">
          <article class="ak-card ak-lab__card">
            <p class="ak-lab__label">Serif / 命令</p>
            <p class="ak-font-serif ak-lab__serif">计算机图形学</p>
            <p class="ak-lab__meta">Computer Graphics</p>
            <p class="ak-lab__body">
              标题用衬线，带出印刷品和档案的古典感。屏幕上的小字号衬线
              笔画太细，所以只用在标题上。
            </p>
          </article>

          <article class="ak-card ak-lab__card">
            <p class="ak-lab__label">Sans / 正文</p>
            <p class="ak-font-sans-serif ak-lab__sans">正文与控件</p>
            <p class="ak-lab__meta">Body &amp; Controls</p>
            <p class="ak-lab__body">
              这是正文层。长度合适的行宽、真实的留白，
              比任何装饰都更能提升可读性。
            </p>
          </article>

          <article class="ak-card ak-lab__card">
            <p class="ak-lab__label">Mono / 数据</p>
            <p class="ak-lab__mono-big">026</p>
            <p class="ak-lab__meta">2026.09.30 / 14:32</p>
            <p class="ak-lab__body">
              编号、时间、参数用等宽。等宽让数字不跳动， 多行数据也能对齐。
            </p>
          </article>
        </div>
      </section>

      {
        /* ============================================================
          3. 信息层级 —— 核心示范
          ============================================================ */
      }
      <section class="ak-lab__section">
        <h2 class="ak-lab__h2">信息层级</h2>
        <p class="ak-lab__desc">
          这一块同时放了标题、状态、数值、时间、编号 —— 但只用了
          <b>一个</b>容器。层级靠字号、字重、对比度、对齐和留白区分，
          不靠给每样东西套一个卡片。
        </p>

        {
          /*
          真实数据：这些数字来自仓库本身，不是编的。
          "每个面板需要一个主导值" —— 这里主导值是文章数。
        */
        }
        <div class="ak-lab__board">
          <div class="ak-lab__board-head">
            <div>
              <p class="ak-lab__label">Blog / Repository</p>
              <p class="ak-lab__board-title">Ethergray Blog</p>
            </div>
            <span class="ak-lab__state ak-lab__state--ok">已构建</span>
          </div>

          <hr class="ak-divider" />

          <dl class="ak-lab__stats">
            <div class="ak-lab__stat">
              <dt>文章</dt>
              <dd>2</dd>
            </div>
            <div class="ak-lab__stat">
              <dt>测试断言</dt>
              <dd>136</dd>
            </div>
            <div class="ak-lab__stat">
              <dt>依赖包</dt>
              <dd>1</dd>
            </div>
            <div class="ak-lab__stat">
              <dt>仓库文件</dt>
              <dd>174</dd>
            </div>
          </dl>

          <hr class="ak-divider" />

          {
            /*
            元数据行：用真实的站点信息，不是装饰性编号。
          */
          }
          <ul class="ak-lab__meta-row">
            <li>站点 / {config.site.url.replace(/^https?:\/\//, "")}</li>
            <li>时区 / {config.site.timezone}</li>
            <li>语言 / {locale}</li>
            <li class="ak-lab__signal">构建通过</li>
          </ul>
        </div>
      </section>

      {
        /* ============================================================
          4. 令牌
          ============================================================ */
      }
      <section class="ak-lab__section">
        <h2 class="ak-lab__h2">设计令牌</h2>
        <p class="ak-lab__desc">
          重复的视觉决定都用公开令牌，不要散落硬编码的颜色、间距和时长 ——
          散落的后果是"改一处不生效"，排查起来很费时间。
        </p>

        <div class="ak-lab__grid ak-lab__grid--2">
          {
            tokenGroups.map(group => (
              <article class="ak-card ak-lab__card">
                <h3 class="ak-lab__h3">{group.title}</h3>
                <p class="ak-lab__body ak-lab__body--tight">{group.note}</p>

                <ul class="ak-lab__tokens">
                  {group.tokens.map(([name, use]) => (
                    <li>
                      <code>{name}</code>
                      <span>{use}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      {
        /* ============================================================
          5. 怎么接进博客
          ============================================================ */
      }
      <section class="ak-lab__section">
        <h2 class="ak-lab__h2">怎么接进博客</h2>

        <div class="ak-lab__grid ak-lab__grid--2">
          <article class="ak-card ak-lab__card">
            <h3 class="ak-lab__h3">品牌映射：把现有颜色接到语义角色上</h3>
            <p class="ak-lab__body">
              不要覆盖 ak-ui 的语义令牌去表达另一个意思，也不要把整套调色板
              换成单一品牌色。正确做法是<b>在局部作用域里</b>把你的品牌变量 接到
              ak-ui 的语义角色上：
            </p>
            <pre
              class="ak-lab__code"><code>{`.blog-shell {
  --ak-signal-info: var(--accent);
  --ak-font-command: var(--ak-font-serif);
}`}</code></pre>
            <p class="ak-lab__body">
              注意是<b>局部作用域</b>（比如 .blog-shell），不是 :root —— 改
              :root 会和现有主题同层竞争，谁后加载谁赢，
              表现为"明明改了变量，颜色却没变"。
            </p>
          </article>

          <article class="ak-card ak-lab__card">
            <h3 class="ak-lab__h3">按需引入：不必吃下整个 90 KB</h3>
            <p class="ak-lab__body">
              <code>style.css</code> 收了 114 个组件类，压缩后 90 KB。 这一页整份引入是为了看全，但博客只需要其中几个
              —— 可以从 SCSS 源里按组件引：
            </p>
            <pre
              class="ak-lab__code"><code>{`@use "@yunyoujun/ak-ui/scss/ak-card";
@use "@yunyoujun/ak-ui/scss/ak-button";`}</code></pre>
            <p class="ak-lab__body">
              每个组件是独立文件（ak-card 1.9 KB、ak-button 4 KB），
              用几个引几个。也可以只引
              <code>tokens.css</code>（2.2 KB）—— 它只有变量，
              不重置任何全局元素。
            </p>
          </article>
        </div>
      </section>

      {
        /* ============================================================
          6. 和 DaisyUI 的关系
          ============================================================ */
      }
      <section class="ak-lab__section">
        <h2 class="ak-lab__h2">和 DaisyUI 的关系</h2>
        <p class="ak-lab__desc">
          两者是<b>替代</b>关系，不是叠加 —— 都提供组件层。但类名前缀不同 （<code
            >ak-*</code
          > 对 <code>btn</code> / <code>card</code>）， 所以可以共存，各管一片：
        </p>

        <ul class="ak-lab__list">
          <li>
            <b>展示页</b>（文章、项目、友链）—— 用 ak-ui。
            这些地方要的是风格和秩序感。
          </li>
          <li>
            <b>后台管理页</b>（表单、表格密集）—— 继续用 DaisyUI。
            那是工具，实用优先，不必为了风格统一去换。
          </li>
          <li>
            <b>Tailwind</b> 保留 —— ak-ui 不管工具类那一层， 布局、间距、响应式还是靠它。
          </li>
        </ul>
      </section>

      {
        /* ============================================================
          页脚：删除方式
          ============================================================ */
      }
      <footer class="ak-lab__footer">
        <hr class="ak-divider" />
        <p class="ak-lab__body ak-lab__body--tight">
          这一页是工作台：不进导航、不进 sitemap、不进搜索索引。 想删掉它 ——
          删这个文件、卸载 <code>@yunyoujun/ak-ui</code>、 再删掉 <code
            >astro.config.ts</code
          > 里 sitemap 的那条排除规则。 博客本身不会受任何影响。
        </p>
        <p class="ak-lab__meta">Design Laboratory / Not Indexed</p>
      </footer>
    </main>
  </body>
</html>

<style>
  /**
   * 这一页自己的样式。
   *
   * 全部用 ak-ui 的令牌，不写死颜色和尺寸 ——
   * 这样以后调整令牌，这一页跟着变，不用回来改样式。
   *
   * Astro 会把 <style> 自动加上 data-astro-cid-* 属性做作用域隔离，
   * 所以这里的规则**不会泄漏到博客的其他页面**。
   */
  .ak-lab {
    /* 独立页面，给一个舒服的阅读宽度和行距 */
    max-width: 68rem;
    margin: 0 auto;
    padding: var(--ak-space-6, 32px) var(--ak-space-5, 24px)
      var(--ak-space-8, 96px);

    /**
     * 品牌映射示范：把 ak-ui 的语义角色接到本站的字体上。
     *
     * 作用域限定在 .ak-lab 里，不碰 :root ——
     * 这是 ak-ui 文档明确要求的做法（"Prefer scoped overrides"）。
     */
    --ak-font-command: var(--ak-font-serif);
  }

  /* ---------- 页头 ---------- */
  .ak-lab__head {
    border-bottom: var(--ak-line-strong, 2px) solid var(--ak-signal-info, #2bf);
    padding-bottom: var(--ak-space-5, 24px);
  }

  .ak-lab__eyebrow {
    font-family: var(--ak-font-mono, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ak-text-secondary);
  }

  .ak-lab__title {
    font-family: var(--ak-font-serif, serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-top: var(--ak-space-3, 12px);
    color: var(--ak-text-primary);
  }

  .ak-lab__lead {
    max-width: 44rem;
    margin-top: var(--ak-space-4, 16px);
    line-height: 1.8;
    color: var(--ak-text-secondary);
  }

  .ak-lab__note {
    margin-top: var(--ak-space-3, 12px);
    font-size: 0.875rem;
    color: var(--ak-signal-accent);
  }

  /* ---------- 区块骨架 ---------- */
  .ak-lab__section {
    margin-top: var(--ak-space-7, 48px);
  }

  .ak-lab__h2 {
    font-family: var(--ak-font-serif, serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--ak-text-primary);
    padding-left: var(--ak-space-3, 12px);

    /* 唯一的强几何手势：标题左边一条粗信号线。
       整页只有这一处，不重复。 */
    border-left: var(--ak-line-strong, 2px) solid var(--ak-signal-info, #2bf);
  }

  .ak-lab__h3 {
    font-family: var(--ak-font-serif, serif);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--ak-text-primary);
  }

  .ak-lab__desc {
    max-width: 44rem;
    margin-top: var(--ak-space-3, 12px);
    line-height: 1.8;
    color: var(--ak-text-secondary);
  }

  .ak-lab__hint {
    margin-top: var(--ak-space-3, 12px);
    font-size: 0.8125rem;
    color: var(--ak-text-secondary);
  }

  .ak-lab__hint kbd {
    font-family: var(--ak-font-mono, monospace);
    border: 1px solid currentcolor;
    border-radius: 2px;
    padding: 0 4px;
  }

  /* ---------- 布局 ---------- */
  .ak-lab__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ak-space-3, 12px);
    margin-top: var(--ak-space-4, 16px);
  }

  .ak-lab__grid {
    display: grid;
    gap: var(--ak-space-4, 16px);
    margin-top: var(--ak-space-4, 16px);
  }

  .ak-lab__grid--2 {
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }

  .ak-lab__grid--3 {
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  /* ---------- 卡片内容 ---------- */
  .ak-lab__card {
    /* ak-card 自带外观，这里只补内边距和排版 */
