---
/**
 * 说说 / 碎片  /notes
 * ============================================================
 * 自包含：只依赖 src/utils/getNotes.ts 和内容集合 src/content/notes/。
 *
 * 想删掉这个页面？
 *   照 src/utils/getNotes.ts 文件头写的 6 步做。
 *
 * 【和文章列表的区别】
 * 文章列表是"目录"：标题 + 摘要 + 链接，点进去看全文。
 * 这里是"时间线"：内容直接摊开，不用点进去 —— 因为每条都很短。
 *
 * 这个区别决定了排版：文章用卡片，说说用一条一条的列表加时间轴。
 * ============================================================
 */
import { getCollection, render } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import Datetime from "@/components/Datetime.astro";

import { getNotes } from "@/utils/getNotes";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const entries = await getCollection("notes");

/**
 * 正文交给 Astro 渲染：`render(entry)` 返回 <Content /> 组件。
 *
 * 为什么不是读 entry.rendered.html 再 set:html：
 *   rendered 只对 .md 存在（.mdx 走延迟渲染，没有这个字段），
 *   用它就等于"只支持 .md，放了 .mdx 会静默渲染成空白"。
 *   这里是 Astro 官方给集合条目的渲染方式，两种格式都能用。
 *
 * 用 Promise.all 是因为要在模板里直接 <Content />，
 * 不能把 await 留在渲染循环里。
 */
const notes = await Promise.all(
  getNotes(entries).map(async entry => ({
    entry,
    Content: (await render(entry)).Content,
  }))
);
---

<Layout
  title={`${t.pages.notesTitle} | ${config.site.title}`}
  description={t.pages.notesDesc}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.pages.notesTitle} pageDesc={t.pages.notesDesc}>
    {
      notes.length === 0 ? (
        <p class="text-base-content-muted">{t.notes.empty}</p>
      ) : (
        /*
          时间轴排版：左边一条竖线，每条一个小圆点。
          用 border-l 画线、绝对定位放圆点，不引入任何依赖。
        */
        <ol class="border-base-300 ml-2 border-l">
          {notes.map(({ entry, Content }) => (
            <li class="relative pb-10 pl-6 last:pb-0">
              {/* 时间轴上的小圆点 */}
              <span
                class="bg-base-100 border-base-300 absolute -left-[5px] mt-1.5 size-[9px] rounded-full border-2"
                aria-hidden="true"
              />

              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <Datetime
                  pubDatetime={entry.data.date}
                  timezone={config.site.timezone}
                  size="sm"
                />
                {entry.data.tags.map(tag => (
                  <span class="badge badge-ghost badge-sm">{tag}</span>
                ))}
              </div>

              {/*
                正文用 Astro 的 <Content /> 渲染（见上面 render 那段注释）。
                内容是我们自己写的 Markdown，不是用户输入 ——
                但即使是自己写的，走框架的渲染也比手写 innerHTML 少一类坑。
              */}
              <div class="prose prose-sm sm:prose-base dark:prose-invert mt-2 max-w-2xl">
                <Content />
              </div>
            </li>
          ))}
        </ol>
      )
    }
  </Main>
  <Footer />
</Layout>
