---
/**
 * 友链页  /friends
 * ============================================================
 * 自包含：只依赖 src/utils/getFriends.ts 和内容集合 src/content/friends/。
 *
 * 想删掉这个页面？
 *   照 src/utils/getFriends.ts 文件头写的 6 步做。
 *
 * 【现在这个页面是空的，这是有意的】
 * 页面上只放**我自己认识的、真的在看的**博客，不对外开放申请。
 * 所以既没有"想交换友链？把信息按这个格式发给我"那种区块，
 * 也没有「在线」标记 —— 那种标记要么是假的（手写的），
 * 要么要去探测几十个外部地址（慢、而且对别人不礼貌）。
 *
 * 想加一个友链：在 src/content/friends/ 下新建一个 Markdown 文件，
 * 字段照着 src/content.config.ts 里的 friends schema 填。
 * ============================================================
 */
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import FriendCard from "./friends/_components/FriendCard.astro";

import { getFriends } from "@/utils/getFriends";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const entries = await getCollection("friends");
const friends = getFriends(entries);
---

<Layout
  title={`${t.pages.friendsTitle} | ${config.site.title}`}
  description={t.pages.friendsDesc}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.pages.friendsTitle} pageDesc={t.pages.friendsDesc}>
    {
      friends.length === 0 ? (
        <p class="text-base-content-muted">{t.friends.empty}</p>
      ) : (
        <div class="flex flex-col gap-4">
          {/*
            条数。为什么要显示：友链页只有名字和头像时，
            看一眼不知道到底有几个 —— 有个数字就有个预期，
            也知道自己有没有滚到底。
            卡片自带足够的视觉重量，这里不需要再加一层"列表标题"。
          */}
          <p class="text-base-content-faint text-xs">
            {tplStr(t.friends.count, { n: friends.length })}
          </p>

          <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {friends.map(friend => (
              <li class="flex">
                {/*
                  flex 是必要的：卡片是 flex 项，父级 <li> 不加 flex 的话
                  同一行两张卡片的高度会不一样（内容少的那张会短一截）。

                  openLabel 里带上站名：读屏软件念一长串友链时，
                  "在新窗口打开"重复 20 遍等于没信息，
                  带上站名才知道这一条是哪家的。
                */}
                <FriendCard
                  friend={friend}
                  openLabel={`${friend.title} —— ${t.friends.openSite}`}
                />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </Main>
  <Footer />
</Layout>
