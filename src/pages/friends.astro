---
/**
 * 友链页  /friends
 * ============================================================
 * 自包含：只依赖 src/utils/getFriends.ts 和内容集合 src/content/friends/。
 *
 * 想删掉这个页面？
 *   照 src/utils/getFriends.ts 文件头写的 6 步做。
 *
 * 【为什么这个页面值得有】
 * 看了同圈子的 65 个博客，42% 都有友链页 —— 它是这个圈子的社交方式。
 * 没有的话，别人想跟你交换链接都找不到入口。
 *
 * 【设计上的两个决定】
 *   1. 用内容集合（一个友链一个 Markdown 文件），加友链不用改代码
 *   2. 不显示"对方是否真的在线"—— 探测几十个外部地址会让页面变慢，
 *      对别人也不礼貌。online 只是个手写标记。
 * ============================================================
 */
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";

import { getFriends } from "@/utils/getFriends";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const entries = await getCollection("friends");
const friends = getFriends(entries);

/**
 * 自己的站点信息，方便别人复制去交换链接。
 * 头像用站点的 OG 图（一定存在，不用额外准备）。
 */
const ownInfo = {
  title: config.site.title,
  description: config.site.description,
  url: config.site.url,
  avatar: new URL(config.site.ogImage, config.site.url).href,
};
---

<Layout
  title={`${t.pages.friendsTitle} | ${config.site.title}`}
  description={t.pages.friendsDesc}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.pages.friendsTitle} pageDesc={t.pages.friendsDesc}>
    {
      friends.length === 0 ? (
        <p class="text-base-content/60">{t.friends.empty}</p>
      ) : (
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {friends.map(friend => (
            <li>
              <a
                href={friend.url}
                target="_blank"
                rel="noopener noreferrer"
                class="card bg-base-200 hover:bg-base-300 h-full p-4 transition-colors"
              >
                <div class="flex items-center gap-3">
                  {/*
                    头像用 <img> 而不是 Astro 的 <Image>：
                    这些图片在**别人的服务器**上，Astro 只能处理本地图片。
                    加 loading="lazy" 和 referrerpolicy 是基本礼貌 ——
                    不把我们页面的来源信息带过去。
                  */}
                  <img
                    src={friend.avatar}
                    alt=""
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    class="bg-base-300 size-12 shrink-0 rounded-full object-cover"
                  />
                  <div class="min-w-0">
                    <div class="flex items-center gap-2">
                      <span class="truncate font-semibold">{friend.title}</span>
                      {friend.online && (
                        <span
                          class="badge badge-success badge-xs shrink-0"
                          title={t.friends.online}
                        />
                      )}
                    </div>
                    <p class="text-base-content/60 mt-1 line-clamp-2 text-sm">
                      {friend.description}
                    </p>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {/* 交换友链的说明 —— 别人想加你时需要知道填什么 */}
    <section class="border-base-300 mt-12 border-t pt-8">
      <h2 class="text-lg font-bold">{t.friends.howToTitle}</h2>
      <p class="text-base-content/70 mt-2 text-sm leading-7">
        {t.friends.howToDesc}
      </p>

      <pre
        class="bg-base-200 mt-4 overflow-x-auto rounded-lg p-4 text-sm"><code>{`名称：${ownInfo.title}
简介：${ownInfo.description}
链接：${ownInfo.url}
头像：${ownInfo.avatar}`}</code></pre>

      <p class="text-base-content/60 mt-4 text-sm">
        {t.friends.contactHint}
      </p>
    </section>
  </Main>
  <Footer />
</Layout>
