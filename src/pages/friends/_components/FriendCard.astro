---
/**
 * 友链卡片
 * ============================================================
 * 自包含模块：依赖 src/utils/getFriends.ts 的类型和现有右箭头图标。
 *
 * 想删掉这个功能？
 *   1. 删掉这个文件
 *   2. 删掉 src/pages/friends.astro 里的 import 和 <FriendCard /> 那一行
 *   （记得连同 src/pages/friends/_components/ 目录一起删）
 * ============================================================
 *
 * 【视觉参考 blog.fqzlr.top/friends/】
 * 取它的紧凑横向布局、圆角方形头像、小标签和悬停箭头；
 * 颜色仍走本站主题。实色表面避免网格透进卡片，导致入口与背景混在一起。
 *
 * 【为什么整张卡片是一个 <a>】
 * 头像和标题都指向同一个地址。拆成两个链接的话，读屏软件会把
 * 同一条友链念两遍 —— 一个 <a> 包住全部内容就没有这个问题，
 * 而且鼠标点哪儿都能跳转，不用瞄准。
 */
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import type { Friend } from "@/utils/getFriends";

type Props = {
  /** 一条友链（形状见 src/utils/getFriends.ts 的 Friend） */
  friend: Friend;
  /**
   * 打开链接的读屏说明，例如「小慕のブログ，在新窗口打开」。
   * 必须由调用方传进来：这个组件不认识 i18n（见 AGENTS.md「中文优先」）。
   */
  openLabel: string;
};

const { friend, openLabel } = Astro.props;
const avatarInitial = Array.from(friend.title.trim())[0];

/**
 * 标签上的 # 前缀只是**习惯**（跟话题标签一样），字段本身存的是纯文字，
 * 所以这里删掉用户可能自己写进去的 #，避免渲染成 ##。
 */
const tags = friend.tags
  .map(tag => tag.replace(/^#+/, "").trim())
  .filter(Boolean);
---

<a
  href={friend.url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={openLabel}
  class="friend-card"
>
  <span class="friend-card__arrow" aria-hidden="true">
    {
      /*
      复用分页那支普通右箭头，用 -rotate-45 转成「↗」（指向右上）。
      特意不新建一个 IconArrowUpRight.svg：多一个 svg 就多一份要维护的资源，
      而顺时针转 45° 和手画的 ↗ 在 16px 下看不出差别。
    */
    }
    <IconArrowRight class="size-4 -rotate-45" />
  </span>

  <span class="friend-card__avatar" aria-hidden="true">
    <span class="friend-card__initial">{avatarInitial}</span>
    {
      /*
      外站头像在浏览器中懒加载，避免构建依赖外站是否可用。
      加载失败后隐藏图片，露出下面的站名首字，不留下破图图标。
    */
    }
    <img
      src={friend.avatar}
      alt=""
      width="56"
      height="56"
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer"
      onerror="this.setAttribute('hidden', '')"
    />
  </span>

  <span class="friend-card__info">
    <span class="friend-card__title">{friend.title}</span>
    <span class="friend-card__desc">{friend.description}</span>

    {
      tags.length > 0 && (
        <span class="friend-card__tags">
          {tags.map(tag => (
            <span class="friend-card__tag">{tag}</span>
          ))}
        </span>
      )
    }
  </span>
</a>

<style>
  .friend-card {
    position: relative;
    display: flex;
    width: 100%;
    min-width: 0;
    align-items: center;
    gap: 0.875rem;
    height: 6rem;
    padding: 0.875rem;
    overflow: hidden;
    border: 1px solid
      color-mix(in oklab, var(--color-base-content) 18%, var(--color-base-100));
    border-radius: 1rem;
    /* 不透明底色挡住页面网格，让卡片边界在深浅主题下都清楚。 */
    background-color: var(--color-base-100);
    color: var(--color-base-content);
    text-decoration: none;
    box-shadow: 0 2px 8px
      color-mix(in oklab, var(--color-base-content) 4%, transparent);
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  /* 鼠标与键盘共享颜色反馈，聚焦时另外保留清晰的轮廓。 */
  .friend-card:hover,
  .friend-card:focus-visible {
    border-color: var(--color-primary);
    background-color: color-mix(
      in oklab,
      var(--color-primary) 6%,
      var(--color-base-100)
    );
    box-shadow: 0 4px 12px
      color-mix(in oklab, var(--color-primary) 10%, transparent);
  }

  .friend-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .friend-card:hover .friend-card__title,
  .friend-card:focus-visible .friend-card__title {
    color: var(--color-primary);
  }

  .friend-card:hover .friend-card__arrow,
  .friend-card:focus-visible .friend-card__arrow {
    opacity: 1;
    transform: none;
  }

  .friend-card:hover .friend-card__avatar,
  .friend-card:focus-visible .friend-card__avatar {
    transform: scale(1.04);
  }

  .friend-card__arrow {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    display: inline-flex;
    color: var(--color-primary);
    opacity: 0;
    transform: translate(-0.25rem, 0.25rem);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .friend-card__avatar {
    position: relative;
    display: inline-flex;
    width: 3.5rem;
    height: 3.5rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 0.875rem;
    background-color: var(--color-base-200);
    color: var(--color-primary);
    transition: transform 0.2s ease;
  }

  .friend-card__initial {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .friend-card__avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .friend-card__info {
    display: flex;
    /* flex 子项默认不能缩得比文字窄；不归零，长站名就会撑破网格列。 */
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.25rem;
  }

  .friend-card__title {
    overflow: hidden;
    padding-right: 1.25rem;
    color: var(--color-base-content);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  /* 单行简介让有无标签、长短文案的卡片保持同一高度。 */
  .friend-card__desc {
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-card__tags {
    display: flex;
    gap: 0.25rem;
    overflow: hidden;
  }

  .friend-card__tag {
    min-width: 0;
    padding: 0.0625rem 0.5rem;
    overflow: hidden;
    border-radius: 9999px;
    background-color: var(--color-base-200);
    color: var(--text-muted);
    font-size: 0.6875rem;
    line-height: 1.6;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* 触屏没有悬停态，保留箭头作为外链提示。 */
  @media (hover: none) {
    .friend-card__arrow {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .friend-card,
    .friend-card__arrow,
    .friend-card__avatar,
    .friend-card__title {
      transition: none;
      transform: none;
    }

    .friend-card:hover .friend-card__avatar,
    .friend-card:focus-visible .friend-card__avatar {
      transform: none;
    }
  }
</style>
