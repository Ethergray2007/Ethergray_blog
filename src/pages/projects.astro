---
/**
 * 项目页  /projects
 * ============================================================
 * 自包含：只依赖 src/utils/getProjects.ts 和内容集合 src/content/projects/。
 *
 * 想删掉这个页面？
 *   照 src/utils/getProjects.ts 文件头写的 6 步做。
 *
 * 【和 /profile 的区别】
 *   /profile  个人主页 —— 我是谁（自己写的，有筛选和徽章，做得很完整）
 *   /projects 项目清单 —— 我做了什么（用集合管理，加项目不用改代码）
 *
 * 【为什么分两个页面而不是合并】
 * 合并意味着要改那个 927 行的个人主页。而两者的数据来源和用途不同：
 * 个人主页是"自我介绍"（很少变），项目页是"清单"（会不断增加）。
 * 合成一个页面之后，每加一个项目都要动那个复杂文件，不划算。
 * ============================================================
 */
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";

import { getProjects } from "@/utils/getProjects";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const entries = await getCollection("projects");
const projects = getProjects(entries);
---

<Layout
  title={`${t.pages.projectsTitle} | ${config.site.title}`}
  description={t.pages.projectsDesc}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.pages.projectsTitle} pageDesc={t.pages.projectsDesc}>
    {
      projects.length === 0 ? (
        <p class="text-base-content/60">{t.projects.empty}</p>
      ) : (
        <ul class="flex flex-col gap-6">
          {projects.map(project => (
            <li class="card bg-base-200 p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <h2 class="text-xl font-bold">{project.title}</h2>

                {/* 状态徽章 */}
                <span class="badge badge-outline badge-sm">
                  {project.status}
                </span>
              </div>

              <p class="text-base-content/70 mt-2 leading-7">
                {project.description}
              </p>

              {/* 技术栈 */}
              {project.tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {project.tags.map(tag => (
                    <span class="badge badge-ghost badge-sm">{tag}</span>
                  ))}
                </div>
              )}

              {/*
                只有确实有地址时才渲染链接 ——
                指向 "#" 的"链接"比没有链接更让人困惑。
              */}
              {project.href && (
                <div class="mt-4">
                  <a
                    href={project.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link link-primary text-sm"
                  >
                    {t.projects.viewSource}
                  </a>
                </div>
              )}

              {/*
                详情正文（Markdown）。
                内容是自己写的，不是用户输入，所以直接渲染 HTML 是安全的 ——
                这一点值得写下来，因为"直接设 HTML"通常是个危险信号。
              */}
              {project.html && (
                <div
                  class="prose prose-sm dark:prose-invert border-base-300 mt-4 max-w-none border-t pt-4"
                  set:html={project.html}
                />
              )}
            </li>
          ))}
        </ul>
      )
    }
  </Main>
  <Footer />
</Layout>
