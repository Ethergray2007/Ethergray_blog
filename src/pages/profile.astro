  <!-- JS -->
  <!-- ========================================================= -->

  <script>
    function initProfilePage() {
      /*
       * Modal
       */
      document
        .querySelectorAll<HTMLElement>("[data-modal-target]")
        .forEach(button => {
          if (button.dataset.bound === "true") return;

          button.dataset.bound = "true";

          button.addEventListener("click", () => {
            const targetId = button.dataset.modalTarget;

            if (!targetId) return;

            const dialog =
              document.getElementById(targetId);

            if (
              dialog instanceof HTMLDialogElement &&
              !dialog.open
            ) {
              dialog.showModal();
            }
          });
        });


      /*
       * Availability toggle
       */
      const toggle =
        document.querySelector<HTMLInputElement>(
          "#availability-toggle"
        );

      const status =
        document.querySelector<HTMLElement>(
          "#availability-text"
        );

      const toast =
        document.querySelector<HTMLElement>(
          "#profile-toast"
        );

      const toastText =
        document.querySelector<HTMLElement>(
          "#profile-toast-text"
        );

      if (
        toggle &&
        toggle.dataset.bound !== "true"
      ) {
        toggle.dataset.bound = "true";

        let toastTimer:
          ReturnType<typeof setTimeout> | undefined;


        toggle.addEventListener("change", () => {
          const enabled = toggle.checked;


          if (status) {
            status.className = enabled
              ? "alert alert-info alert-soft mt-4 text-sm"
              : "alert alert-neutral alert-soft mt-4 text-sm";


            status.innerHTML = enabled
              ? `
                <span class="status status-info"></span>
                <span>欢迎交流有趣的项目</span>
              `
              : `
                <span class="status status-neutral"></span>
                <span>当前专注于学习</span>
              `;
          }


          if (
            toast &&
            toastText
          ) {
            toastText.textContent =
              enabled
                ? "已开启交流状态"
                : "已关闭交流状态";

            toast.classList.remove("hidden");


            if (toastTimer) {
              clearTimeout(toastTimer);
            }


            toastTimer =
              setTimeout(() => {
                toast.classList.add("hidden");
              }, 2200);
          }
        });
      }


      /*
       * Project filter
       */
      const filterMenu =
        document.querySelector<HTMLDetailsElement>(
          "#project-filter-menu"
        );

      const filterLabel =
        document.querySelector<HTMLElement>(
          "#project-filter-label"
        );

      const cards =
        Array.from(
          document.querySelectorAll<HTMLElement>(
            ".project-card"
          )
        );

      const emptyState =
        document.querySelector<HTMLElement>(
          "#project-empty"
        );


      filterMenu
        ?.querySelectorAll<HTMLButtonElement>(
          "[data-filter]"
        )
        .forEach(button => {
          if (button.dataset.bound === "true") return;

          button.dataset.bound = "true";


          button.addEventListener("click", () => {
            const filter =
              button.dataset.filter ?? "all";

            const label =
              button.textContent?.trim() ?? "筛选";


            if (filterLabel) {
              filterLabel.textContent = label;
            }


            let visibleCount = 0;


            cards.forEach(card => {
              const tags =
                card.dataset.tags?.split(" ") ?? [];

              const visible =
                filter === "all" ||
                tags.includes(filter);


              card.classList.toggle(
                "hidden",
                !visible
              );


              if (visible) {
                visibleCount += 1;
              }
            });


            emptyState?.classList.toggle(
              "hidden",
              visibleCount !== 0
            );


            filterMenu.removeAttribute("open");
          });
        });
    }


    /*
     * 初次进入页面
     */
    initProfilePage();


    /*
     * Astro View Transitions
     */
    document.addEventListener(
      "astro:page-load",
      initProfilePage
    );
  </script>
