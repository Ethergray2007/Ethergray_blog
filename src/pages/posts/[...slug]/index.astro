---
import { type CollectionEntry, getCollection, render } from "astro:content";

import PostLayout from "@/layouts/PostLayout.astro";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";

import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";

import EditPost from "./_components/EditPost.astro";
import ShareLinks from "./_components/ShareLinks.astro";
import BackButton from "./_components/BackButton.astro";
import AdjacentPostNav from "./_components/AdjacentPostNav.astro";
import TableOfContents from "./_components/TableOfContents.astro";
import CopyCodeButton from "./_components/CopyCodeButton.astro";

import { useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sortedPosts = getSortedPosts(posts);

  return sortedPosts.map((post, index) => ({
    params: {
      slug: getPostSlug(post.id, post.filePath),
    },

    props: {
      post,

      prevPost:
        index > 0
          ? {
              id: sortedPosts[index - 1].id,
              title: sortedPosts[index - 1].data.title,
              filePath: sortedPosts[index - 1].filePath,
            }
          : null,

      nextPost:
        index < sortedPosts.length - 1
          ? {
              id: sortedPosts[index + 1].id,
              title: sortedPosts[index + 1].data.title,
              filePath: sortedPosts[index + 1].filePath,
            }
          : null,
    },
  }));
}

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  post: CollectionEntry<"posts">;
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { post, prevPost, nextPost } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const {
  title,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
} = post.data;

const { Content, headings } = await render(post);

/**
 * 封面图。
 *
 * 以前这里要判两种类型（Astro 的图片对象 / 普通字符串），因为文章还在
 * 文件系统里时，ogImage 可以写成相对于文章文件的图片路径。
 * 现在文章存在数据库里，没有文件可以比对，它只可能是一个字符串。
 */
let ogImageUrl: string | undefined = initOgImage;

if (!ogImageUrl && config.features.dynamicOgImage) {
  const postUrl = getPostUrl(post.id, post.filePath, locale).replace(
    /\/+$/,
    ""
  );

  ogImageUrl = `${postUrl}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header />

  <BackButton />

  <main
    id="main-content"
    class:list={[
      "reading-shell pb-12 sm:pb-16 lg:pb-20",
      {
        "mt-8": !config.features.showBackButton,
      },
    ]}
    data-pagefind-body
  >
    <!-- Article header -->
    <header class="card card-border bg-base-100 mb-6 shadow-sm sm:mb-8">
      <div class="card-body gap-4 p-5 sm:p-7 lg:p-8">
        <div
          class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
        >
          <h1
            style={{
              viewTransitionName: toTransitionName(title),
            }}
            class="text-base-content min-w-0 text-3xl leading-tight font-black tracking-tight sm:text-4xl lg:text-5xl"
          >
            {title}
          </h1>

          {
            !hideEditPost && config.features.editPost?.enabled && (
              <EditPost {hideEditPost} {post} class="shrink-0 max-sm:hidden" />
            )
          }
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />

          {
            description && (
              <span class="text-base-content-faint hidden text-sm sm:inline">
                ·
              </span>
            )
          }

          {
            description && (
              <span class="text-base-content-muted hidden max-w-full text-sm leading-6 sm:inline">
                {description}
              </span>
            )
          }
        </div>
      </div>
    </header>

    <!-- 目录：标题列表直接用 Astro 提取的 headings（见组件的文件头说明） -->
    <TableOfContents {headings} />

    <!-- Article content -->
    <article
      id="article"
      class="card card-border bg-base-100 min-w-0 shadow-sm"
      data-heading-link-label={t.post.headingLink}
      data-copy-label={t.post.copy}
      data-copy-code-label={t.post.copyCode}
      data-copied-label={t.post.copied}
      data-copy-failed-label={t.post.copyFailed}
    >
      <div class="card-body min-w-0 p-5 sm:p-8 lg:p-10">
        <div
          class:list={[
            "app-prose w-full min-w-0",
            "prose-pre:bg-(--shiki-light-bg)",
            "dark:prose-pre:bg-(--shiki-dark-bg)",
          ]}
        >
          <Content />
        </div>
      </div>
    </article>

    <!-- 代码块复制按钮：脚本会自己找到所有代码块挂上去 -->
    <CopyCodeButton />

    <!-- Article actions -->
    <section class="mt-6 sm:mt-8">
      <div class="card card-border bg-base-100 shadow-sm">
        <div class="card-body gap-5 p-5 sm:p-6">
          <!-- Mobile edit -->
          {
            !hideEditPost && config.features.editPost?.enabled && (
              <div class="sm:hidden">
                <EditPost {hideEditPost} {post} />
              </div>
            )
          }

          <!-- Tags -->
          {
            tags.length > 0 && (
              <div class="flex flex-col gap-3">
                <span class="text-base-content-muted text-sm font-semibold">
                  {t.post.tagLabel}
                </span>

                <ul class="flex flex-wrap gap-2">
                  {tags.map(tag => (
                    <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
                  ))}
                </ul>
              </div>
            )
          }

          <!-- Share -->
          <ShareLinks />
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="my-6 sm:my-8">
      <div class="divider"></div>
    </div>

    <!-- Previous / Next -->
    <AdjacentPostNav {prevPost} {nextPost} />

    <!--
      返回顶部按钮用的是页面顶部的 <BackButton />，这里不再放第二个。
      原来这里还有个 <BackToTopButton />，它和 BackButton 的
      id / data-* 选择器一模一样，而两边的脚本都用 document.querySelector
      取**第一个**匹配 —— 于是它永远绑不上事件、容器停在 opacity-0
      （等于不存在），还给页面留下重复 id。那个组件已经删掉。
    -->
  </main>

  <Footer />
</PostLayout>

<script is:inline data-astro-rerun>
  /*
   * ============================
   * Scroll progress
   * ============================
   */

  if (window.__articleProgressCleanup) {
    window.__articleProgressCleanup();
  }

  function createProgressBar() {
    const existingProgress = document.getElementById("scroll-progress");

    if (existingProgress) {
      existingProgress.remove();
    }

    const progressContainer = document.createElement("div");

    progressContainer.id = "scroll-progress";

    progressContainer.className = "fixed top-0 z-50 h-1 w-full bg-base-100";

    const progressBar = document.createElement("div");

    progressBar.id = "myBar";

    progressBar.className = "h-1 w-0 bg-primary";

    progressContainer.appendChild(progressBar);

    document.body.appendChild(progressContainer);
  }

  function setupScrollProgress() {
    createProgressBar();

    function update() {
      const winScroll = window.scrollY;

      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;

      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;

      const myBar = document.getElementById("myBar");

      if (myBar) {
        myBar.style.width = `${Math.min(100, Math.max(0, scrolled))}%`;
      }
    }

    window.addEventListener("scroll", update, { passive: true });

    update();

    window.__articleProgressCleanup = function () {
      window.removeEventListener("scroll", update);

      document.getElementById("scroll-progress")?.remove();
    };
  }

  setupScrollProgress();

  /*
   * ============================
   * Heading anchor links
   * ============================
   */

  function addHeadingLinks() {
    const article = document.getElementById("article");

    if (!article) {
      return;
    }

    /*
     * 无障碍文案从 data-* 属性上读，不在脚本里写死。
     *
     * 【为什么要绕这一下】
     * 这段是 is:inline 脚本 —— 它在浏览器里跑，拿不到服务端渲染时的
     * t 对象（i18n）。原来这里直接写着英文 "Link to this section"，
     * 于是中文站点上的读屏提示是英文的。
     * 按项目约定，界面文案必须走 src/i18n/，所以由模板把译好的
     * 字符串写到 data-heading-link-label 上，脚本只负责读取。
     */
    const label = article.dataset.headingLinkLabel ?? "";

    const headings = Array.from(article.querySelectorAll("h2, h3, h4, h5, h6"));

    for (const heading of headings) {
      if (heading.querySelector(".heading-link")) {
        continue;
      }

      if (!heading.id) {
        continue;
      }

      heading.classList.add("group");

      const link = document.createElement("a");

      link.className =
        "heading-link ms-2 no-underline text-primary opacity-60 transition-opacity hover:opacity-100 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";

      link.href = `#${heading.id}`;

      if (label) {
        link.setAttribute("aria-label", label);
      }

      const span = document.createElement("span");

      span.setAttribute("aria-hidden", "true");

      span.innerText = "#";

      link.appendChild(span);

      heading.appendChild(link);
    }
  }

  addHeadingLinks();

  /*
   * ============================
   * 代码块复制按钮
   * ============================
   *
   * 【为什么这里没有代码】
   * AstroPaper 模板原本在这段位置有一个 attachCopyButtons()，
   * 用 `#article pre` 抓**所有**代码块，然后把一个写着 "Copy"
   * 的按钮 appendChild 进 <pre> 里面。
   *
   * 它有两个问题：
   *
   *   1. Mermaid 图表读不出来。Mermaid 用 `diagram.textContent`
   *      取图表定义，而 textContent 会把子元素的文字也算进去
   *      （CSS 定位不影响它）—— 于是图表定义末尾多了个 "Copy"，
   *      解析报错：Parse error on line 7 ... F[结束]Copy
   *
   *   2. 和 CopyCodeButton.astro 重复，Shiki 代码块上出现两个按钮。
   *
   * 现在统一用 CopyCodeButton.astro，它的选择器是 `pre.astro-code`，
   * 只匹配 Shiki 高亮的代码块，天然避开 `<pre class="mermaid">`。
   */

  /*
   * ============================
   * Astro View Transitions
   * ============================
   */

  if (!window.__articlePageEventsBound) {
    window.__articlePageEventsBound = true;

    document.addEventListener("astro:before-swap", event => {
      if (window.__articleProgressCleanup) {
        window.__articleProgressCleanup();
      }

      const color = document
        .querySelector("meta[name='theme-color']")
        ?.getAttribute("content");

      if (color && event.newDocument) {
        event.newDocument
          .querySelector("meta[name='theme-color']")
          ?.setAttribute("content", color);
      }
    });

    document.addEventListener("astro:after-swap", () => {
      window.scrollTo({
        left: 0,
        top: 0,
        behavior: "instant",
      });
    });
  }
</script>

<script>
  /**
   * 图片灯箱
   * ============================================================
   * 点正文里的图片放大。用 medium-zoom 这个库，不自己写。
   *
   * 【为什么不再手写】
   * 这里原来有 ~330 行手写实现：自己建遮罩层、自己做焦点陷阱、
   * 自己实现双指缩放 / 双击放大 / 放大后拖拽、自己管 body 滚动锁 ——
   * 而这些都是"图片放大"这个需求的通用部分。
   * medium-zoom 是这件事上最常用的库（约 2KB），
   * 鼠标、键盘、手势都支持：点图片放大，点任意处 / 按键 / 滚动关闭。
   *
   * 【为什么这段是独立的 <script> 而不是并进上面那段】
   * 上面那段是 is:inline 的内联脚本，内联脚本不能写 import。
   * 这一段要让 Vite 把 medium-zoom 打包进来，所以必须是模块脚本。
   *
   * 【为什么不用 define:vars 把文案传进来】
   * 图片的可访问名直接用图片自己的 alt —— 正文图片本来就必须写 alt，
   * 再单独做一份"放大图片"的文案是重复的，也就不用动 i18n。
   * ============================================================
   */
  import mediumZoom from "medium-zoom";

  let zoom: ReturnType<typeof mediumZoom> | null = null;

  function initZoom() {
    /* ClientRouter 切换页面后 DOM 会被换掉，先解绑上一次的 */
    zoom?.detach();
    zoom = null;

    const article = document.getElementById("article");

    if (!article) {
      return;
    }

    /* 被 <a> 包着的图片不接管 —— 那种图点了是要跳转的 */
    const images = Array.from(article.querySelectorAll("img")).filter(
      image => !image.closest("a")
    );

    if (images.length === 0) {
      return;
    }

    zoom = mediumZoom(images, {
      margin: 24,
      background: "rgb(0 0 0 / 0.8)",
    });

    /*
     * 键盘可达：图片默认不能被 Tab 聚焦，所以补上 role + tabindex，
     * 并在 Enter / 空格时打开 —— medium-zoom 只管鼠标和手势，不碰键盘。
     */
    for (const image of images) {
      image.setAttribute("role", "button");
      image.setAttribute("tabindex", "0");
      image.setAttribute("aria-haspopup", "dialog");

      image.addEventListener("keydown", event => {
        if (event.key !== "Enter" && event.key !== " ") {
          return;
        }

        event.preventDefault();
        void zoom?.open({ target: image });
      });
    }

    /* 离开当前页时把放大状态收掉，否则遮罩会跟着新页面留下来 */
    document.addEventListener(
      "astro:before-swap",
      () => {
        void zoom?.close();
      },
      { once: true }
    );
  }

  document.addEventListener("astro:page-load", initZoom);
  initZoom();
</script>
