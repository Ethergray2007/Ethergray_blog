---
/**
 * 阅读时长徽标
 * ============================================================
 * 自包含模块：计算方法 + 图标 + 文案渲染，全在这一个文件里。
 *
 * 想删掉这个功能？
 *   1. 删掉这个文件
 *   2. 删掉文章页里的 <ReadingTime ... /> 那一行
 *   3. 删掉 src/utils/getReadingTime.ts
 *   4. 删掉 i18n 里的 post.readingTime（可选，留着也不影响）
 * ============================================================
 */
import IconClock from "@/assets/icons/IconClock.svg";

import { getReadingTime } from "@/utils/getReadingTime";
import { tplStr, useTranslations } from "@/i18n";

type Props = {
  /** 文章正文（Markdown 原文），传 post.body 即可 */
  body: string;
};

const { body } = Astro.props;

// 右上角是本站当前语言（zh / en），文案从 src/i18n 里取
const t = useTranslations(Astro.currentLocale);

// 只拿分钟数，拼文案是下面模板的事
const minutes = getReadingTime(body);
---

<span class="badge badge-ghost badge-lg gap-2">
  <IconClock class="size-4" />
  {tplStr(t.post.readingTime, { minutes })}
</span>
