---
/**
 * 文章目录（TOC）
 * ============================================================
 * 自包含模块：标题列表由 Astro 提供，这里只负责渲染。
 *
 * 【为什么不自己解析 Markdown 标题】
 * 这里原来调 `getTableOfContents(post.body)`：拿正文正则扫 ## / ###，
 * 再用 github-slugger 算锚点 id。那是**重造轮子**，而且是个会漂移的轮子 ——
 * id 必须和 Astro 写进 HTML 的完全一致，任何语法差异都会变成"点了不动"：
 *   · 标题里带链接：Astro 用渲染后的文字算（参考-mdn），
 *     正则拿到的是原文（参考-mdnhttpsmdnio）
 *   · 还有代码块、行内 HTML、转义字符、收尾井号……
 *     每多支持一种写法就多一个坑，最后光"把 Markdown 拆成纯文本"
 *     就写了 60 行。
 *
 * Astro 的 `render(post)` 本来就返回
 *     headings: { depth, slug, text }[]
 * 其中 slug 就是它写进 `<h2 id="...">` 的那个值。直接用它，
 * 上面那一整类问题从根上不存在 —— 少一个文件、少一套会过时的规则。
 *
 * 想删掉目录功能？
 *   1. 删掉这个文件
 *   2. 删掉文章页里的 <TableOfContents /> 那一行
 *   3. 删掉 i18n 里的 post.toc（可选，留着也不影响）
 * ============================================================
 */
import type { MarkdownHeading } from "astro";
import { useTranslations } from "@/i18n";

type Props = {
  /** 直接传 render(post) 的 headings */
  headings: MarkdownHeading[];
};

const { headings } = Astro.props;

const t = useTranslations(Astro.currentLocale);

/**
 * 只留 h2 / h3。
 *
 * h1 是文章标题本身，放进目录没意义；
 * h4 及更深在侧栏里会挤成一团，也去掉。
 * （Astro 给的 headings 含全部层级，筛选是我们的事。）
 */
const visibleHeadings = headings.filter(
  heading => heading.depth === 2 || heading.depth === 3
);
---

{
  /* 少于两条就不显示目录，避免占地方 */
  visibleHeadings.length > 1 && (
    /*
     * ⚠️ open 是有意加的，默认展开。
     *
     * 原来的写法没有 open，目录默认是折叠的 —— 而 <summary> 里
     * 只有一个词「目录」。结果页面上呈现为一张**空卡片**：
     * 占了卡片的内边距和位置，却不提供任何信息，
     * 读者得先意识到"这里能点"才会看到内容。
     *
     * 展开之后摘要行变成一个小标题，列表直接可见 ——
     * 该有的信息一眼就在，需要收起的人仍然可以点它折起来，
     * 两种需求都满足。
     */
    <details
      open
      class="card card-border bg-base-100 group mb-6 shadow-sm sm:mb-8"
    >
      <summary class="hover:text-primary flex cursor-pointer list-none items-center justify-between gap-3 p-4 font-semibold transition-colors select-none sm:px-5">
        <span class="inline-flex items-center gap-2">{t.post.toc}</span>

        {/*
          折叠指示箭头。
          用 CSS 的 group-open: 旋转，不写 JS —— details 的展开状态
          浏览器自己管，脚本去同步它只会多一个出错的地方。
          aria-hidden：它是纯视觉提示，读屏软件已经从 details 的
          语义里知道这是可展开的了。
        */}
        <svg
          class="text-base-content-faint size-4 shrink-0 transition-transform duration-200 group-open:rotate-180"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>

      <nav class="px-4 pb-4 sm:px-5" aria-label={t.post.toc}>
        <ul class="border-base-300 space-y-2 border-s ps-4 text-sm">
          {visibleHeadings.map(heading => (
            <li class:list={[{ "ps-4": heading.depth === 3 }]}>
              <a
                href={`#${heading.slug}`}
                class="text-base-content-strong hover:text-primary link-hover transition-colors"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )
}
