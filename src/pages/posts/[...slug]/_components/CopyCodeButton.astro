---
/**
 * 代码块一键复制
 * ============================================================
 * 自包含模块：没有任何参数，放进页面就会自动给所有代码块加复制按钮。
 *
 * 为什么按钮是"浏览器里挂上去的"？
 *   代码块是 Markdown 在**构建时**渲染成 HTML 的，
 *   服务端并不知道有几个代码块、每个在哪。
 *   所以这个组件的 script 在浏览器里跑，找到所有代码块再挂按钮。
 *   这就是"服务端渲染"和"客户端脚本"配合的典型例子。
 *
 * ⚠️ 在 .astro 文件里提到标签名或行内代码时，不要写出对应的符号。
 *
 *   这个文件的注释曾经因此报过两次 PARSE_ERROR：
 *     1. 写出带尖括号的 script 标签名 → 编译器把它当成真正的
 *        script 标签开头，后面的中文被当成 JavaScript 解析
 *     2. 写出反引号 → 编译器把它当成模板字符串的开头，
 *        一路"未终止"，整个组件解析失败
 *
 *   用文字描述（"script 标签""反引号"）就不会有问题。
 *
 * 想删掉这个功能？
 *   1. 删掉这个文件
 *   2. 删掉文章页里的 CopyCodeButton 那一行
 * ============================================================
 */
---

<!-- 不渲染任何可见的东西，只负责挂脚本 -->
<script>
  /**
   * 拿到代码块的纯文本内容。
   *
   * 为什么用 querySelectorAll("code") 再拼接，而不是直接读 innerText？
   *   因为 Shiki 会把代码拆成很多 <span> 来做语法高亮。
   *   用 textContent 可以稳定拿到"不含标签"的原文，
   *   而且每行是一个 <span class="line">，按行拼接能保住换行符。
   */
  function getCodeText(codeBlock: HTMLElement): string {
    const lines = codeBlock.querySelectorAll(".line");

    if (lines.length === 0) {
      return codeBlock.textContent ?? "";
    }

    return Array.from(lines)
      .map(line => line.textContent ?? "")
      .join("\n");
  }

  /**
   * 复制文本到剪贴板。
   *
   * navigator.clipboard 只在 https 或 localhost 下可用，
   * 所以保留一个降级方案（用隐藏的 textarea + execCommand）。
   */
  async function copyText(text: string): Promise<boolean> {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // 用户拒绝授权或非安全上下文，走下面的降级方案
      }
    }

    try {
      const textarea = document.createElement("textarea");
      textarea.value = text;
      // 放到屏幕外，避免页面滚动
      textarea.style.position = "fixed";
      textarea.style.opacity = "0";
      document.body.append(textarea);
      textarea.select();
      // execCommand 已被标记为过时，但它是非安全上下文下唯一可行的方案。
      // 现代浏览器优先走上面的 navigator.clipboard，这里只是兜底。
      // 用 @ts-ignore 而不是 @ts-expect-error：
      //   后者会在"没有错误可压制"时报错，而 tsc 和 Astro 语言服务
      //   对这个 API 的判断不一致，会导致构建失败。
      // @ts-ignore -- 故意调用被标记为 deprecated 的 API
      const ok = document.execCommand("copy");
      textarea.remove();
      return ok;
    } catch {
      return false;
    }
  }

  function initCopyButtons() {
    /**
     * 只处理围栏代码块。Astro 给它们加了 .astro-code 类，
     * 行内代码（用反引号括起来的那种）没有这个类，不会被误加按钮。
     *
     * ⚠️ 上面这句原本写的是带反引号的「行内代码」，结果这个 script
     *   里的注释被当成模板字符串的开头，把后面的代码全吞了，
     *   整个组件报 PARSE_ERROR。
     *   在 script 标签内的注释里不要使用反引号。
     */
    const blocks = document.querySelectorAll<HTMLElement>("pre.astro-code");

    blocks.forEach(block => {
      // 防止重复挂载（View Transitions 来回切换时会重新执行）
      if (block.dataset.copyReady === "true") {
        return;
      }

      block.dataset.copyReady = "true";

      /*
       * 为什么要在代码块外面再包一层？
       *
       * 代码块自己有 overflow-x: auto（长行要能横向滚）。
       * 按钮如果直接挂在它里面，"右边缘"指的是**内容**的右边缘，
       * 横向滚动时按钮会跟着滚走 —— 实测滚动 426px，按钮从左下
       * 飘到代码文字上面去。
       *
       * 包一层之后，外层不滚动，按钮相对外层定位，就永远待在
       * 右上角。外层没有任何自己的样式，margin 会正常合并，
       * 所以段落间距和包之前完全一样。
       */
      let holder = block.parentElement;

      if (!holder?.classList.contains("code-block")) {
        holder = document.createElement("div");
        holder.className = "code-block";
        block.before(holder);
        holder.append(block);
      }

      const button = document.createElement("button");
      button.type = "button";
      button.className = "code-copy-btn";
      button.textContent = "复制";
      // 读屏软件靠这个知道按钮是干什么的
      button.setAttribute("aria-label", "复制代码");

      button.addEventListener("click", async () => {
        const ok = await copyText(getCodeText(block));

        button.textContent = ok ? "已复制" : "复制失败";
        button.dataset.state = ok ? "done" : "error";

        // 1.5 秒后恢复，避免按钮一直停在"已复制"
        window.setTimeout(() => {
          button.textContent = "复制";
          delete button.dataset.state;
        }, 1500);
      });

      holder.append(button);
    });
  }

  // 首次加载
  initCopyButtons();

  // View Transitions 切换页面后重新挂载
  document.addEventListener("astro:page-load", initCopyButtons);
</script>

<!--
  ⚠️ 这里必须写 is:global，不能是普通的 scoped 样式。

  普通 <style> 会被 Astro 加上 data-astro-cid-xxx 属性选择器，
  而那个属性只加在**组件模板里写出来的元素**上。
  这个组件的模板是空的，代码块来自 Markdown、按钮来自下面的脚本，
  两者都没有那个属性 —— 于是整段样式一条都匹配不上。

  踩过的坑：产物里**根本没有** .code-copy-btn 这条规则（不是"被覆盖"，
  是被整段丢掉）。表现是复制按钮变成一个没样式的原生按钮，
  挤在代码内容末尾、被 overflow-x 裁掉一半，只看得见一个「复」字。
  dev 和 build 都一样，因为作用域是编译期决定的。

  写 is:global 之后选择器保持原样。pre.astro-code 和 .code-copy-btn
  都只出现在文章页，不会污染别处。
  （src/pages/search.astro 里的 #pagefind-search 出于同样原因是 is:global）
-->
<style is:global>
  /*
   * 外层容器。它自己不产生任何视觉，只负责"不滚动"，
   * 这样按钮的右边缘才是屏幕上的右边缘（见上面脚本里的注释）。
   */
  .code-block {
    position: relative;
  }

  .code-copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;

    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-base-300);
    border-radius: 0.375rem;

    background: var(--color-base-100);
    color: var(--color-base-content);
    font-size: 0.75rem;
    line-height: 1.5;

    cursor: pointer;
    /* 平时半透明，鼠标移到代码块或按钮获得焦点时才完全显示 */
    opacity: 0.45;
    transition:
      opacity 150ms ease,
      background-color 150ms ease;
  }

  .code-block:hover .code-copy-btn,
  .code-copy-btn:focus-visible {
    opacity: 1;
  }

  .code-copy-btn:hover {
    background: var(--color-base-200);
  }

  .code-copy-btn[data-state="done"] {
    color: var(--color-success, #16a34a);
    opacity: 1;
  }

  .code-copy-btn[data-state="error"] {
    color: var(--color-error, #dc2626);
    opacity: 1;
  }

  /* 触屏设备没有 hover，直接常显，否则用户根本发现不了 */
  @media (hover: none) {
    .code-copy-btn {
      opacity: 1;
    }
  }
</style>
