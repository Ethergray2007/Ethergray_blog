---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";

import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

const featuredPosts = sortedPosts.filter(({ data }) => data.featured);

const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />

  {
    /*
    ============================================================
    首屏
    ============================================================
    ⚠️ 它在 <main> **外面**，这是有意的。

    因为 main 用的是 content-shell（max-w-5xl 限宽 + 左右留白），
    背景图放进去会被限制成一条竖条 —— 看起来是"一个卡片"，
    而不是"一个首屏"。移出来之后背景才能铺满整个屏幕宽度。

    容器（限宽 + 留白）改到内部那层，这样文字仍然和下方的
    文章列表对齐，不会因为铺满而跑到屏幕最左边。
    ============================================================
  */
  }
  <section id="hero">
    {
      /*
      背景图（.hero__bg 的 background-image）+ 压暗层，两层都绝对定位铺满。
      文字那层用 z-10 压在上面（见下面那个 div）。

      背景图为什么用 CSS 而不是 <img>：见 src/styles/hero.css 里的说明 ——
      一句话是"离线压好的 108 KB 比构建时处理 6 MB 原图更划算"。
    */
    }
    <div class="hero__bg" aria-hidden="true"></div>

    <div class="hero__scrim" aria-hidden="true"></div>

    {
      /*
      干净的「左图右文」—— 首屏只负责"我是谁"，不掺文章内容。

      ⚠️ 之前这里塞过一张「最新一篇」的小卡片，这次去掉了。原因：
      首页只有一篇文章时，它和下面「最近文章」里那张卡**是同一篇** ——
      同一屏出现两次，看着像出错。
      而且左栏只有一张小卡片、还和右栏文字底端对齐，
      两栏之间没有任何关系，读起来很散。

      现在的分工：
        首屏  我是谁（标题 + 说明 + 入口）
        下面  有什么内容（文章列表）
    */
    }
    <div class="content-shell hero__content">
      <div class="hero__text">
        <div class="mb-5 flex flex-wrap items-center gap-2">
          <span class="badge badge-primary badge-soft">
            {t.home.badge}
          </span>

          <a
            target="_blank"
            rel="noreferrer"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="btn btn-ghost btn-sm gap-2"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss class="size-4" />
            RSS
          </a>
        </div>

        {
          /*
          标题用 text-5xl 而不是 6xl：
          中文没有词间空格，同样字号下视觉重量比英文大得多，
          6xl 的中文标题会显得压人。
        */
        }
        <h1 class="hero__title text-4xl font-black sm:text-5xl">
          {t.home.heroTitle}
        </h1>

        {
          /*
          ⚠️ 三段文字的宽度**统一**成 max-w-xl。
          之前标题是 max-w-3xl、正文是 max-w-2xl —— 右边缘参差不齐，
          看起来像没对齐。统一之后右边是一条直线。
        */
        }
        <p class="hero__lead mt-4 max-w-xl text-lg leading-8">
          {t.home.heroLead}
        </p>

        <p class="hero__more mt-2 max-w-xl leading-7">
          {t.home.heroMore}
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          {
            /*
          指向仓库首页而不是 #readme ——
          README 是给开发者看的，访客点进去会一头雾水；
          仓库首页至少能看到这是个什么项目。
        */
          }
          <a
            href="https://github.com/Ethergray2007/Ethergray_blog"
            target="_blank"
            rel="noreferrer"
            class="btn btn-primary"
          >
            {t.home.viewSource}
          </a>

          <a
            href={getRelativeLocaleUrl(locale, "profile")}
            class="btn btn-outline"
          >
            {t.home.viewProfile}
          </a>

          <a href={getRelativeLocaleUrl(locale, "now")} class="btn btn-outline">
            {t.nav.now}
          </a>
        </div>
      </div>
    </div>
  </section>

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="content-shell pb-8 sm:pb-10 lg:pb-12"
  >
    <!-- Featured -->
    {
      featuredPosts.length > 0 && (
        <section id="featured" class="mt-10 sm:mt-12">
          <div class="mb-5 flex items-end justify-between gap-4">
            <div>
              <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
                {t.home.featured}
              </h2>

              <p class="text-base-content-muted mt-1 text-sm sm:text-base">
                {t.home.featuredDesc}
              </p>
            </div>
          </div>

          <ul class="grid grid-cols-1 gap-x-5 lg:grid-cols-2">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- Recent Posts -->
    {
      recentPosts.length > 0 && (
        <section
          id="recent-posts"
          class="border-base-300 mt-10 border-t pt-10 sm:mt-12 sm:pt-12"
        >
          <div class="mb-5">
            <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
              {t.home.recentPosts}
            </h2>

            <p class="text-base-content-muted mt-1 text-sm sm:text-base">
              {t.home.recentPostsDesc}
            </p>
          </div>

          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- All Posts -->
    <section
      class="border-base-300 mt-8 flex justify-center border-t pt-8 sm:mt-10 sm:pt-10"
    >
      <a href={getRelativeLocaleUrl(locale, "posts")} class="btn btn-outline">
        {t.home.allPosts}

        <IconArrowRight class="size-4 rtl:-rotate-180" />
      </a>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout =
      document.querySelector<HTMLElement>("#main-content")?.dataset;

    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");

    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
