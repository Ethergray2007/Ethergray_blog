---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";

import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

const featuredPosts = sortedPosts.filter(({ data }) => data.featured);

const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

/**
 * 首屏左栏显示的「最新一篇」。
 *
 * 为什么不复用「精选」或「最近文章」的第一篇：
 * 那两个区块在首屏下方紧接着就出现了，重复显示会显得啰嗦。
 * 这里取**整个列表的第一篇**（getSortedPosts 已按时间倒序），
 * 是"最新"这个语义本身 —— 和下面那个列表是包含关系，
 * 但读者的感受是"首屏先给一个入口"，不是重复。
 */
const latestPost = sortedPosts.at(0);

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />

  {
    /*
    ============================================================
    首屏
    ============================================================
    ⚠️ 它在 <main> **外面**，这是有意的。

    因为 main 用的是 content-shell（max-w-5xl 限宽 + 左右留白），
    背景图放进去会被限制成一条竖条 —— 看起来是"一个卡片"，
    而不是"一个首屏"。移出来之后背景才能铺满整个屏幕宽度。

    容器（限宽 + 留白）改到内部那层，这样文字仍然和下方的
    文章列表对齐，不会因为铺满而跑到屏幕最左边。
    ============================================================
  */
  }
  <section id="hero">
    {
      /*
      背景图（.hero__bg 的 background-image）+ 压暗层，两层都绝对定位铺满。
      文字那层用 z-10 压在上面（见下面那个 div）。

      背景图为什么用 CSS 而不是 <img>：见 src/styles/hero.css 里的说明 ——
      一句话是"离线压好的 108 KB 比构建时处理 6 MB 原图更划算"。
    */
    }
    <div class="hero__bg" aria-hidden="true"></div>

    <div class="hero__scrim" aria-hidden="true"></div>

    {
      /*
      布局：宽屏时两栏（左空右文），窄屏时单栏上下堆叠。

      ⚠️ 文字在**右栏**、左栏留白 —— 这不是排版随意，是跟着图走的：
      背景图里人物在中间偏左，文字放右边才不会压在她脸上。

      左栏那个「最新一篇」是为了填补空白 ——
      否则整块左下角空空如也，看着像没做完。
    */
    }
    <div
      class="content-shell relative z-10 grid gap-8 py-14 sm:py-20 lg:grid-cols-[1fr_minmax(0,30rem)] lg:items-end lg:py-24"
    >
      <!-- 左栏：留白 + 最新一篇 -->
      <div class="order-2 lg:order-1">
        {
          latestPost && (
            <a
              href={getPostUrl(latestPost.id, latestPost.filePath, locale)}
              class="hero__latest block max-w-sm p-4"
            >
              <span class="hero__latest-label font-mono text-xs">
                {t.home.latestLabel}
              </span>

              <span class="hero__latest-title mt-2 block font-semibold">
                {latestPost.data.title}
              </span>

              <span class="hero__latest-desc mt-1 line-clamp-2 block text-sm">
                {latestPost.data.description}
              </span>
            </a>
          )
        }
      </div>

      <!-- 右栏：标题、说明、按钮 -->
      <div class="order-1 lg:order-2">
        <div class="mb-5 flex flex-wrap items-center gap-2">
          <span class="badge badge-primary badge-soft">
            {t.home.badge}
          </span>

          <a
            target="_blank"
            rel="noreferrer"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="btn btn-ghost btn-sm gap-2"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss class="size-4" />
            RSS
          </a>
        </div>

        {
          /*
          标题用 text-5xl 而不是 6xl：
          中文没有词间空格，同样字号下视觉重量比英文大得多，
          6xl 的中文标题会显得压人。
        */
        }
        <h1 class="hero__title text-4xl font-black sm:text-5xl">
          {t.home.heroTitle}
        </h1>

        {
          /*
          ⚠️ 三段文字的宽度**统一**成 max-w-xl。
          之前标题是 max-w-3xl、正文是 max-w-2xl —— 右边缘参差不齐，
          看起来像没对齐。统一之后右边是一条直线。
        */
        }
        <p class="hero__lead mt-4 max-w-xl text-lg leading-8">
          {t.home.heroLead}
        </p>

        <p class="hero__more mt-2 max-w-xl leading-7">
          {t.home.heroMore}
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          {
            /*
          指向仓库首页而不是 #readme ——
          README 是给开发者看的，访客点进去会一头雾水；
          仓库首页至少能看到这是个什么项目。
        */
          }
          <a
            href="https://github.com/Ethergray2007/Ethergray_blog"
            target="_blank"
            rel="noreferrer"
            class="btn btn-primary"
          >
            {t.home.viewSource}
          </a>

          <a
            href={getRelativeLocaleUrl(locale, "profile")}
            class="btn btn-outline"
          >
            {t.home.viewProfile}
          </a>

          <a href={getRelativeLocaleUrl(locale, "now")} class="btn btn-outline">
            {t.nav.now}
          </a>
        </div>
      </div>
    </div>
  </section>

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="content-shell pb-8 sm:pb-10 lg:pb-12"
  >
    <!-- Featured -->
    {
      featuredPosts.length > 0 && (
        <section id="featured" class="mt-10 sm:mt-12">
          <div class="mb-5 flex items-end justify-between gap-4">
            <div>
              <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
                {t.home.featured}
              </h2>

              <p class="text-base-content-muted mt-1 text-sm sm:text-base">
                {t.home.featuredDesc}
              </p>
            </div>
          </div>

          <ul class="grid grid-cols-1 gap-x-5 lg:grid-cols-2">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- Recent Posts -->
    {
      recentPosts.length > 0 && (
        <section
          id="recent-posts"
          class="border-base-300 mt-10 border-t pt-10 sm:mt-12 sm:pt-12"
        >
          <div class="mb-5">
            <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
              {t.home.recentPosts}
            </h2>

            <p class="text-base-content-muted mt-1 text-sm sm:text-base">
              {t.home.recentPostsDesc}
            </p>
          </div>

          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- All Posts -->
    <section
      class="border-base-300 mt-8 flex justify-center border-t pt-8 sm:mt-10 sm:pt-10"
    >
      <a href={getRelativeLocaleUrl(locale, "posts")} class="btn btn-outline">
        {t.home.allPosts}

        <IconArrowRight class="size-4 rtl:-rotate-180" />
      </a>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout =
      document.querySelector<HTMLElement>("#main-content")?.dataset;

    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");

    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
