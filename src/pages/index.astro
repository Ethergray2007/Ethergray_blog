---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";

import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

const featuredPosts = sortedPosts.filter(
  ({ data }) => data.featured
);

const recentPosts = sortedPosts.filter(
  ({ data }) => !data.featured
);

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="content-shell py-8 sm:py-10 lg:py-12"
  >
    <!-- Hero -->
    <section
      id="hero"
      class="card border border-base-300 bg-base-100 shadow-sm"
    >
      <div class="card-body p-6 sm:p-8 lg:p-10">
        <div
          class="mb-4 flex flex-wrap items-center gap-2"
        >
          <span class="badge badge-primary badge-soft">
            Blog
          </span>

          <a
            target="_blank"
            rel="noreferrer"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="btn btn-ghost btn-sm gap-2"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss class="size-4" />
            RSS
          </a>
        </div>

        <h1
          class="max-w-3xl text-4xl font-black tracking-tight sm:text-5xl lg:text-6xl"
        >
          Welcome
        </h1>

        <p
          class="mt-4 max-w-2xl text-lg leading-8 text-base-content/70 sm:text-xl"
        >
          欢迎来到我的博客。
        </p>

        <p
          class="mt-2 max-w-2xl leading-7 text-base-content/60"
        >
          这里记录算法、编程、图形学学习过程，以及值得长期保留的技术内容。
        </p>

        <div
          class="mt-6 flex flex-wrap gap-3"
        >
          <a
            href="https://github.com/Ethergray2007/Ethergray_blog#readme"
            target="_blank"
            rel="noreferrer"
            class="btn btn-primary"
          >
            查看 README
          </a>

          <a
            href={getRelativeLocaleUrl(locale, "profile")}
            class="btn btn-outline"
          >
            个人主页
          </a>
        </div>
      </div>
    </section>

    <!-- Featured -->
    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class="mt-10 sm:mt-12"
        >
          <div class="mb-5 flex items-end justify-between gap-4">
            <div>
              <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
                {t.home.featured}
              </h2>

              <p class="mt-1 text-sm text-base-content/55 sm:text-base">
                值得优先阅读的文章
              </p>
            </div>
          </div>

          <ul class="grid grid-cols-1 gap-x-5 lg:grid-cols-2">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- Recent Posts -->
    {
      recentPosts.length > 0 && (
        <section
          id="recent-posts"
          class="mt-10 border-t border-base-300 pt-10 sm:mt-12 sm:pt-12"
        >
          <div class="mb-5">
            <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
              {t.home.recentPosts}
            </h2>

            <p class="mt-1 text-sm text-base-content/55 sm:text-base">
              最近更新的文章
            </p>
          </div>

          <ul>
            {recentPosts
              .slice(0, postsConfig.perIndex)
              .map(data => (
                <Card variant="h3" {...data} />
              ))}
          </ul>
        </section>
      )
    }

    <!-- All Posts -->
    <section
      class="mt-8 flex justify-center border-t border-base-300 pt-8 sm:mt-10 sm:pt-10"
    >
      <a
        href={getRelativeLocaleUrl(locale, "posts")}
        class="btn btn-outline"
      >
        {t.home.allPosts}

        <IconArrowRight
          class="size-4 rtl:-rotate-180"
        />
      </a>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout =
      document.querySelector<HTMLElement>("#main-content")
        ?.dataset;

    const baseRoot =
      import.meta.env.BASE_URL.replace(/\/?$/, "/");

    if (indexLayout?.layout) {
      sessionStorage.setItem(
        "backUrl",
        indexLayout.homePath ?? baseRoot
      );
    }
  });
</script>