---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import MotionShowcase from "@/components/MotionShowcase.astro";
import Hero from "@/components/Hero.astro";

import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getFriends } from "@/utils/getFriends";
import { getNotes } from "@/utils/getNotes";
import { getProjects } from "@/utils/getProjects";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

const featuredPosts = sortedPosts.filter(({ data }) => data.featured);

const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

/**
 * 阅读区后面的轻量内容导航。
 *
 * 数量全部来自**真实的内容集合**，不是写死的数字 ——
 * 所以加了文章、加了友链，这里会跟着变。
 *
 * 为什么要在这里再查一遍集合（「最近文章」用的是 posts）：
 * 这四个集合本来就各查各的，没有共用列表可比。
 * 而且 getUniqueTags / getFriends 这些函数已经处理好了
 * 排序、去重、过滤草稿，直接调用比自己在这里重写一遍可靠。
 */
const [friendEntries, noteEntries, projectEntries] = await Promise.all([
  getCollection("friends"),
  getCollection("notes"),
  getCollection("projects"),
]);

const browseItems = [
  {
    href: getRelativeLocaleUrl(locale, "notes"),
    label: t.nav.notes,
    count: getNotes(noteEntries).length,
  },
  {
    href: getRelativeLocaleUrl(locale, "projects"),
    label: t.nav.projects,
    count: getProjects(projectEntries).length,
  },
  {
    href: getRelativeLocaleUrl(locale, "friends"),
    label: t.nav.friends,
    count: getFriends(friendEntries).length,
  },
  {
    href: getRelativeLocaleUrl(locale, "tags"),
    label: t.nav.tags,
    count: getUniqueTags(posts).length,
  },
];

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />

  {
    /* 全屏首屏。它被收进组件了（src/components/Hero.astro），想改构图去那里。 */
  }
  <Hero />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="content-shell home-content pt-10 pb-10 sm:pt-14 sm:pb-12 lg:pt-16 lg:pb-16"
  >
    {/* 海报负责个性，内容区先呈现文章，分类入口和动图放在阅读之后。 */}
    <div id="reading" tabindex="-1">
      <!-- Featured -->
      {
        featuredPosts.length > 0 && (
          <section id="featured" class="mb-12 sm:mb-16">
            <div class="mb-5 flex items-end justify-between gap-4">
              <div>
                <h2 class="section-heading">{t.home.featured}</h2>

                <p class="section-lede">{t.home.featuredDesc}</p>
              </div>
            </div>

            <ul class="post-list grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-5">
              {featuredPosts.slice(0, 2).map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
        )
      }

      <!-- Recent Posts -->
      {
        recentPosts.length > 0 && (
          <section id="recent-posts" class="mb-8">
            <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
              <div>
                <h2 class="section-heading">{t.home.recentPosts}</h2>
                <p class="section-lede">{t.home.recentPostsDesc}</p>
              </div>
              <a
                href={getRelativeLocaleUrl(locale, "posts")}
                class="link link-hover text-primary inline-flex min-h-11 shrink-0 items-center gap-2 text-sm font-semibold"
              >
                {t.home.allPosts}
                <IconArrowRight class="size-4 rtl:-rotate-180" />
              </a>
            </div>

            <ul class="post-list grid gap-4 sm:gap-5">
              {recentPosts.slice(0, postsConfig.perIndex).map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
        )
      }
    </div>

    {/* 即使还没有文章，阅读入口也能抵达文章列表。 */}
    {
      recentPosts.length === 0 && (
        <a href={getRelativeLocaleUrl(locale, "posts")} class="btn btn-outline">
          {t.home.allPosts}
        </a>
      )
    }

    <section
      id="browse"
      class="border-base-300 mt-12 border-t pt-8 sm:mt-16 sm:pt-10"
    >
      <div class="mb-5">
        <h2 class="section-heading">{t.home.browseTitle}</h2>

        <p class="section-lede">{t.home.browseDesc}</p>
      </div>

      {/* 实色表面挡住背景网格，避免入口与页面底色混在一起。 */}
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
        {
          browseItems.map(item => (
            <li class="h-full">
              <a
                href={item.href}
                class="group border-base-content/15 bg-base-100 hover:border-primary focus-visible:border-primary hover:bg-base-200 focus-visible:bg-base-200 flex h-full min-h-16 items-center justify-between gap-3 rounded-lg border px-4 py-3 shadow-sm transition-colors duration-200"
              >
                <span class="relative min-w-0">
                  <span class="group-hover:text-primary group-focus-visible:text-primary block font-semibold tracking-tight transition-colors">
                    {item.label}
                  </span>
                </span>

                {/*
                  数量。用 tabular-nums 让它等宽 ——
                  否则 1 和 8 宽度不同，右侧会跳。
                */}
                <span class="flex shrink-0 items-center gap-2">
                  <span class="text-base-content-muted font-mono text-sm tabular-nums">
                    {item.count}
                  </span>
                  <IconArrowRight
                    class="text-base-content-faint group-hover:text-primary group-focus-visible:text-primary size-3.5 transition-colors rtl:-rotate-180"
                    aria-hidden="true"
                  />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <MotionShowcase />
  </main>

  <Footer />
</Layout>

<style>
  /* 卡片在其他页面靠外边距分隔；首页交给 grid 的 gap，避免两种间距叠加。 */
  .post-list > :global(li) {
    margin-block: 0;
  }

  .home-content {
    background-image: radial-gradient(
      ellipse 100% 18rem at 50% 0,
      color-mix(in oklab, var(--color-primary) 6%, transparent),
      transparent
    );
  }
</style>
