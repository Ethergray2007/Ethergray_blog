---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import MotionShowcase from "@/components/MotionShowcase.astro";
import Hero from "@/components/Hero.astro";

import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getFriends } from "@/utils/getFriends";
import { getNotes } from "@/utils/getNotes";
import { getProjects } from "@/utils/getProjects";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

const featuredPosts = sortedPosts.filter(({ data }) => data.featured);

const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

/**
 * 「从哪看起」那一排入口。
 *
 * 数量全部来自**真实的内容集合**，不是写死的数字 ——
 * 所以加了文章、加了友链，这里会跟着变。
 *
 * 为什么要在这里再查一遍集合（下面「最近文章」用的是 posts）：
 * 这四个集合本来就各查各的，没有共用列表可比。
 * 而且 getUniqueTags / getFriends 这些函数已经处理好了
 * 排序、去重、过滤草稿，直接调用比自己在这里重写一遍可靠。
 */
const [friendEntries, noteEntries, projectEntries] = await Promise.all([
  getCollection("friends"),
  getCollection("notes"),
  getCollection("projects"),
]);

const browseItems = [
  {
    href: getRelativeLocaleUrl(locale, "posts"),
    label: t.nav.posts,
    desc: t.home.recentPostsDesc,
    count: sortedPosts.length,
  },
  {
    href: getRelativeLocaleUrl(locale, "notes"),
    label: t.nav.notes,
    desc: t.pages.notesDesc,
    count: getNotes(noteEntries).length,
  },
  {
    href: getRelativeLocaleUrl(locale, "projects"),
    label: t.nav.projects,
    desc: t.pages.projectsDesc,
    count: getProjects(projectEntries).length,
  },
  {
    href: getRelativeLocaleUrl(locale, "friends"),
    label: t.nav.friends,
    desc: t.pages.friendsDesc,
    count: getFriends(friendEntries).length,
  },
  {
    href: getRelativeLocaleUrl(locale, "tags"),
    label: t.nav.tags,
    desc: t.pages.tagsDesc,
    count: getUniqueTags(posts).length,
  },
  {
    href: getRelativeLocaleUrl(locale, "archives"),
    label: t.nav.archives,
    desc: t.pages.archivesDesc,
    count: sortedPosts.length,
  },
];

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />

  {
    /* 全屏首屏。它被收进组件了（src/components/Hero.astro），想改构图去那里。 */
  }
  <Hero />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="content-shell pt-10 pb-8 sm:pt-12 sm:pb-10 lg:pb-12"
  >
    {
      /*
      ============================================================
      从哪看起
      ============================================================
      列各内容类型的入口 + 真实数量。

      【为什么需要这一块】
      顶部导航为了清爽只留了 4 个内容链接，「标签」「归档」移到了页脚。
      但那样它们也更难被发现 —— 这个区块正好把缺口补回来。

      【和顶部导航的分工】
        顶部   去哪儿（始终可见，4 个内容类型）
        这里   有什么（带数量，一眼看出哪个板块有内容）

      数量是**真实**的（来自各内容集合），不是装饰性数字。
      某个板块为空时它会显示 0 —— 这也是诚实的：
      与其藏起来，不如让人一眼看出"这里还没东西"。
      ============================================================
    */
    }
    {
      /*
      ⚠️ 「动图」区块（MotionShowcase）原来在这个位置 ——
      也就是「从哪看起」**上面**。改版时把它移到了文章列表下面。

      理由是构图问题：那两张 GIF 在页面上占了将近一整屏。
      放在这里会把"从哪看起"和"最近文章"一起挤到第二屏 ——
      读者打开首页看到的是两张动图，而不是"这个站有什么内容"。

      首页的信息优先级应该是：
        首屏（我是谁）→ 有什么 → 最近写了什么 → 这些动图
      动图是装饰性的趣味内容，排在最后不影响任何人，
      放前面却会挡住主要内容。
    */
    }

    <section id="browse">
      <div class="mb-5">
        <h2 class="section-heading">{t.home.browseTitle}</h2>

        <p class="section-lede">{t.home.browseDesc}</p>
      </div>

      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          browseItems.map(item => (
            <li>
              <a
                href={item.href}
                class="card border-base-300 bg-base-100 hover:border-primary/60 hover:bg-base-200/60 group flex h-full flex-row items-center justify-between gap-3 border p-4 transition-colors"
              >
                <span class="min-w-0">
                  <span class="block truncate font-semibold">{item.label}</span>
                  <span class="text-base-content-muted mt-0.5 block truncate text-sm">
                    {item.desc}
                  </span>
                </span>

                {/*
                  数量。用 tabular-nums 让它等宽 ——
                  否则 1 和 8 宽度不同，右侧会跳。
                */}
                <span class="text-base-content-faint group-hover:text-primary shrink-0 font-mono text-lg tabular-nums transition-colors">
                  {item.count}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Featured -->
    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class="border-base-300 mt-10 border-t pt-10 sm:mt-12 sm:pt-12"
        >
          <div class="mb-5 flex items-end justify-between gap-4">
            <div>
              <h2 class="section-heading">{t.home.featured}</h2>

              <p class="section-lede">{t.home.featuredDesc}</p>
            </div>
          </div>

          <ul class="grid grid-cols-1 gap-x-5 lg:grid-cols-2">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- Recent Posts -->
    {
      recentPosts.length > 0 && (
        <section
          id="recent-posts"
          class="border-base-300 mt-10 border-t pt-10 sm:mt-12 sm:pt-12"
        >
          <div class="mb-5">
            <h2 class="section-heading">{t.home.recentPosts}</h2>

            <p class="section-lede">{t.home.recentPostsDesc}</p>
          </div>

          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- Motion（装饰性内容，排在所有正文区块之后） -->
    <MotionShowcase />

    <!-- All Posts -->
    <section
      class="border-base-300 mt-8 flex justify-center border-t pt-8 sm:mt-10 sm:pt-10"
    >
      <a href={getRelativeLocaleUrl(locale, "posts")} class="btn btn-outline">
        {t.home.allPosts}

        <IconArrowRight class="size-4 rtl:-rotate-180" />
      </a>
    </section>
  </main>

  <Footer />
</Layout>
