---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";

import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

const featuredPosts = sortedPosts.filter(({ data }) => data.featured);

const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="content-shell py-8 sm:py-10 lg:py-12"
  >
    <!-- Hero -->
    <section
      id="hero"
      class="card border-base-300 bg-base-100 border shadow-sm"
    >
      <div class="card-body p-6 sm:p-8 lg:p-10">
        <div class="mb-4 flex flex-wrap items-center gap-2">
          <span class="badge badge-primary badge-soft">
            {t.home.badge}
          </span>

          <a
            target="_blank"
            rel="noreferrer"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="btn btn-ghost btn-sm gap-2"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss class="size-4" />
            RSS
          </a>
        </div>

        <h1
          class="max-w-3xl text-4xl font-black tracking-tight sm:text-5xl lg:text-6xl"
        >
          {t.home.heroTitle}
        </h1>

        <p
          class="text-base-content/70 mt-4 max-w-2xl text-lg leading-8 sm:text-xl"
        >
          {t.home.heroLead}
        </p>

        <p class="text-base-content/60 mt-2 max-w-2xl leading-7">
          {t.home.heroMore}
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          {
            /*
            指向仓库首页而不是 #readme ——
            README 是给开发者看的，访客点进去会一头雾水；
            仓库首页至少能看到这是个什么项目。
          */
          }
          <a
            href="https://github.com/Ethergray2007/Ethergray_blog"
            target="_blank"
            rel="noreferrer"
            class="btn btn-primary"
          >
            {t.home.viewSource}
          </a>

          <a
            href={getRelativeLocaleUrl(locale, "profile")}
            class="btn btn-outline"
          >
            {t.home.viewProfile}
          </a>

          <a href={getRelativeLocaleUrl(locale, "now")} class="btn btn-outline">
            {t.nav.now}
          </a>
        </div>
      </div>
    </section>

    <!-- Featured -->
    {
      featuredPosts.length > 0 && (
        <section id="featured" class="mt-10 sm:mt-12">
          <div class="mb-5 flex items-end justify-between gap-4">
            <div>
              <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
                {t.home.featured}
              </h2>

              <p class="text-base-content/55 mt-1 text-sm sm:text-base">
                {t.home.featuredDesc}
              </p>
            </div>
          </div>

          <ul class="grid grid-cols-1 gap-x-5 lg:grid-cols-2">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- Recent Posts -->
    {
      recentPosts.length > 0 && (
        <section
          id="recent-posts"
          class="border-base-300 mt-10 border-t pt-10 sm:mt-12 sm:pt-12"
        >
          <div class="mb-5">
            <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
              {t.home.recentPosts}
            </h2>

            <p class="text-base-content/55 mt-1 text-sm sm:text-base">
              {t.home.recentPostsDesc}
            </p>
          </div>

          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- All Posts -->
    <section
      class="border-base-300 mt-8 flex justify-center border-t pt-8 sm:mt-10 sm:pt-10"
    >
      <a href={getRelativeLocaleUrl(locale, "posts")} class="btn btn-outline">
        {t.home.allPosts}

        <IconArrowRight class="size-4 rtl:-rotate-180" />
      </a>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout =
      document.querySelector<HTMLElement>("#main-content")?.dataset;

    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");

    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
