---
/**
 * 标签页 /tags
 * ============================================================
 * 显示全站所有标签，按"文章数量从多到少"排序，并标出每个标签有几篇文章。
 *
 * 为什么要显示数量和排序：
 *   只列一堆标签词，读者不知道哪个值得点、哪个点进去只有一篇文章。
 *   加上数量之后，一眼就能看出这个博客主要在写什么。
 *
 * 数据来源：src/utils/getUniqueTags.ts 里的 getTagsWithCount()
 * ============================================================
 */
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";

import { getTagsWithCount } from "@/utils/getUniqueTags";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts");

const tags = getTagsWithCount(posts);

/**
 * 一共覆盖了多少个"文章-标签"关系。
 *
 * 这一项和 tags.length 不是一回事：
 *   tags.length        有多少个不同的标签
 *   taggedPostCount    这些标签加起来标记了多少次
 *
 * 注意它也不是"文章数" —— 一篇文章有 3 个标签就会被算 3 次。
 * 所以下面那句文案写的是"标签引用"，不写"文章"。
 */
const taggedPostCount = tags.reduce((sum, tag) => sum + tag.count, 0);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    {
      tags.length > 0 ? (
        <section aria-labelledby="tags-list-title">
          <h2 id="tags-list-title" class="sr-only">
            {t.pages.tagsTitle}
          </h2>

          <div class="rounded-box border-base-300 bg-base-100 border p-4 shadow-sm sm:p-6">
            <ul class="flex flex-wrap gap-2.5 sm:gap-3">
              {tags.map(({ tag, tagName, count }) => (
                <Tag {tag} {tagName} {count} size="lg" />
              ))}
            </ul>
          </div>

          {/* 说明统计口径，数字按文章数排序 */}
          <p class="text-base-content-faint mt-4 text-sm">
            {tags.length} 个标签 · 共 {taggedPostCount} 次标签引用 ·
            按文章数排序
          </p>
        </section>
      ) : (
        <div class="alert alert-soft">
          <span>{t.a11y.noResults}</span>
        </div>
      )
    }
  </Main>

  <Footer />
</Layout>
