---
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";

import { getUniqueTags } from "@/utils/getUniqueTags";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection(
  "posts",
  ({ data }) => !data.draft
);

const tags = getUniqueTags(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={t.pages.tagsTitle}
    pageDesc={t.pages.tagsDesc}
  >
    {
      tags.length > 0 ? (
        <section aria-labelledby="tags-list-title">
          <h2 id="tags-list-title" class="sr-only">
            {t.pages.tagsTitle}
          </h2>

          <div
            class="rounded-box border border-base-300 bg-base-100 p-4 shadow-sm sm:p-6"
          >
            <ul class="flex flex-wrap gap-2.5 sm:gap-3">
              {tags.map(({ tag, tagName }) => (
                <Tag
                  {tag}
                  {tagName}
                  size="lg"
                />
              ))}
            </ul>
          </div>
        </section>
      ) : (
        <div class="alert alert-soft">
          <span>{t.a11y.noResults}</span>
        </div>
      )
    }
  </Main>

  <Footer />
</Layout>