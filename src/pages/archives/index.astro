---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";

import { postFilter } from "@/utils/postFilter";
import {
  getPostsByGroupCondition,
  getTopTagsInGroup,
} from "./_utils/getPostsByGroupCondition";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `showArchives` config is false
const notFoundUrl = getRelativeLocaleUrl(locale, "404");

if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);

const posts = await getCollection("posts");
const filteredPosts = posts.filter(postFilter);

const monthFormatter = new Intl.DateTimeFormat(locale, {
  month: "long",
});

const postsByYear = Object.entries(
  getPostsByGroupCondition(filteredPosts, post =>
    post.data.pubDatetime.getFullYear()
  )
).sort(([yearA], [yearB]) => Number(yearB) - Number(yearA));

/**
 * 每年的标签小结。
 *
 * 只算一次而不是放在模板的循环里算 ——
 * 模板里对同一个年份可能渲染多次，重复统计是浪费。
 */
const topTagsByYear = new Map(
  postsByYear.map(([year, yearGroup]) => [year, getTopTagsInGroup(yearGroup)])
);
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.archivesTitle} pageDesc={t.pages.archivesDesc}>
    <div class="space-y-12">
      {
        postsByYear.map(([year, yearGroup]) => {
          const postsByMonth = Object.entries(
            getPostsByGroupCondition(
              yearGroup,
              post => post.data.pubDatetime.getMonth() + 1
            )
          ).sort(([monthA], [monthB]) => Number(monthB) - Number(monthA));

          return (
            <section aria-labelledby={`archive-year-${year}`}>
              {/* Year header */}
              <div class="mb-6 flex flex-wrap items-center gap-3">
                {/*
                  这是**年份**（2026），不是区块标题 ——
                  所以不用 section-heading：那个是给「最近文章」这类
                  有语义名称的分区标题用的。年份是个数字标识，
                  比区块标题更大一号才压得住下面整条时间轴。
                */}
                <h2
                  id={`archive-year-${year}`}
                  class="text-3xl font-black tracking-tight sm:text-4xl"
                >
                  {year}
                </h2>

                <span class="badge badge-neutral badge-sm">
                  {yearGroup.length}
                </span>

                {/* 这一年的标签小结：让读者一眼看出主题分布 */}
                {(topTagsByYear.get(year) ?? []).length > 0 && (
                  <span class="text-base-content-faint flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                    {(topTagsByYear.get(year) ?? []).map(({ tag, tagName }) => (
                      <a
                        href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
                        class="link link-hover"
                      >
                        #{tagName}
                      </a>
                    ))}
                  </span>
                )}
              </div>

              {/* Timeline */}
              <ul class="timeline timeline-vertical archive-timeline max-md:timeline-compact">
                {postsByMonth.map(([month, monthGroup], monthIndex) => {
                  const sortedMonthPosts = [...monthGroup].sort(
                    (a, b) =>
                      new Date(b.data.pubDatetime).getTime() -
                      new Date(a.data.pubDatetime).getTime()
                  );

                  const monthName = monthFormatter.format(
                    new Date(2000, Number(month) - 1, 1)
                  );

                  return (
                    <li>
                      {/* Timeline point */}
                      <div class="timeline-middle">
                        <div class="bg-primary ring-base-100 size-3 rounded-full ring-4" />
                      </div>

                      {/* Month */}
                      <div class="timeline-end mb-8 w-full max-w-none md:mb-10 md:w-[calc(100%-2rem)]">
                        <div class="mb-4 flex items-center gap-2">
                          <h3 class="text-lg font-bold sm:text-xl">
                            {monthName}
                          </h3>

                          <span class="badge badge-ghost badge-sm">
                            {monthGroup.length}
                          </span>
                        </div>

                        <ul class="space-y-4 sm:space-y-5">
                          {sortedMonthPosts.map(data => (
                            <Card {...data} />
                          ))}
                        </ul>
                      </div>

                      {/* Timeline line */}
                      {monthIndex < postsByMonth.length - 1 && (
                        <hr class="bg-base-300" />
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          );
        })
      }
    </div>
  </Main>

  <Footer />
</Layout>

<!--
  时间轴：让圆点对齐「月份标题」，而不是整条的中点。

  【daisyUI 默认是怎么摆的】
  每条 li 是个三行网格，行高来自 CSS 变量：

      grid-template-rows: var(--timeline-row-start, minmax(0,1fr)) auto var(--timeline-row-end, minmax(0,1fr))
      .timeline-vertical > li        { --timeline-row-start: minmax(0,1fr); --timeline-row-end: minmax(0,1fr) }
      .timeline-vertical .timeline-end { grid-area: 1/3/4/4; place-self: center flex-start }

  也就是：圆点占中间那行，内容**跨三行并垂直居中**。

  【后果（实测，不是看着不对劲）】
  圆点落在整条 li 的垂直中点上 —— 比「九月」标题低 132px，
  看着像贴在卡片中间；而那条 li 高 301px、内容只有 245px，
  底部还多出 56px 空白。月份越多，这种"错位 + 空白"越明显。

  【这里的做法】
  本页的标记只有「圆点 + 内容 + 一条连线」三样东西，不需要三行：

      行1 = auto（内容撑开）   行2 = auto（空）   行3 = 0
      圆点和内容都放进第 1 行、顶部对齐
      连线跨第 1~2 行，于是正好贯通整条

  选择器都比 daisyUI 的多一个元素或类：它那些规则是
  `.timeline-vertical .timeline-end`（0,2,0），而这里是
  `ul.archive-timeline .timeline-end`（0,2,1）。
  不这么写的话，同权重下谁生效取决于样式表顺序 ——
  那种"有时候对有时候不对"最难查。
-->
<style>
  ul.archive-timeline > li {
    /* 覆盖 daisyUI 设的两个变量：第一行按内容，最后一行不要留空 */
    --timeline-row-start: auto;
    --timeline-row-end: 0;
  }

  /* 圆点：从中间行挪到第一行，并对着月份标题那一行的中线 */
  ul.archive-timeline .timeline-middle {
    grid-area: 1 / 2 / 2 / 3;
    align-self: start;
    /*
     * 12px 是为了让圆点（含 ring 视觉高度 20px）的中点落在
     * 月份标题行（行高 28px）的中线上 —— 实测这样正好对齐。
     */
    margin-top: 0.75rem;
  }

  /*
   * 内容：放进第一行、顶部对齐。
   * 不覆盖的话它会跨三行 + 垂直居中（这就是错位的直接原因）。
   */
  ul.archive-timeline .timeline-end {
    grid-area: 1 / 3 / 2 / 4;
    place-self: start flex-start;
  }

  /*
   * 连线：贯穿整条。
   * daisyUI 默认是 grid-area: 3/2/none —— 只画在第三行，而第三行现在是 0 高，
   * 不覆盖的话月份之间的竖线会整条消失。
   */
  ul.archive-timeline > li > hr:last-child {
    grid-area: 1 / 2 / 3 / 3;
  }
</style>
