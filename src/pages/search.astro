---
/**
 * 实时文章搜索
 * ============================================================
 * GET 表单可在没有 JavaScript 时使用，脚本只增强等待状态与结果刷新。
 * 想删除：删此页面、api/public-search.ts、utils/publicSearch.ts，
 * 再移除页眉搜索入口、i18n 搜索文案与 README 登记。
 * ============================================================
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { searchPublicPosts } from "@/lib/publicPosts";
import { logPublicReadError } from "@/lib/publicCache";
import { getPostUrl } from "@/utils/getPostPaths";
import { getAssetPath } from "@/utils/withBase";
import {
  parseSearchQuery,
  SEARCH_RESULT_LIMIT,
  toPublicSearchResult,
  type PublicSearchResult,
} from "@/utils/publicSearch";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const prerender = false;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (config.features.search === false && notFoundUrl)
  return Astro.rewrite(notFoundUrl);

const { query, error } = parseSearchQuery(Astro.url.searchParams.get("q"));
let results: PublicSearchResult[] = [];
let message = t.pages.searchPrompt;
// 搜索 URL 含关键词，每次都查公开数据，不把旧结果缓存成文章发布后的搜索快照。
Astro.response.headers.set("Cache-Control", "no-store");
if (error) {
  Astro.response.status = 400;
  message = t.pages.searchQueryTooLong;
} else if (query) {
  try {
    results = (await searchPublicPosts(query, SEARCH_RESULT_LIMIT)).map(post =>
      toPublicSearchResult(post, getPostUrl(post.id, post.filePath, locale))
    );
    message = results.length
      ? t.pages.searchResults.replace("{{n}}", String(results.length))
      : t.pages.searchEmpty;
  } catch (readError) {
    logPublicReadError(readError);
    Astro.response.status = 503;
    message = t.pages.searchFailed;
  }
}
---

<Layout title={`${t.pages.searchTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.pages.searchTitle} pageDesc={t.pages.searchDesc}>
    <section
      id="live-search"
      aria-labelledby="search-section-title"
      data-endpoint={getAssetPath("api/public-search")}
      data-locale={locale}
      data-prompt={t.pages.searchPrompt}
      data-loading={t.pages.searchLoading}
      data-empty={t.pages.searchEmpty}
      data-failed={t.pages.searchFailed}
      data-count={t.pages.searchResults}
      data-too-long={t.pages.searchQueryTooLong}
    >
      <h2 id="search-section-title" class="sr-only">{t.pages.searchTitle}</h2>
      <form
        id="search-form"
        method="get"
        role="search"
        class="border-base-300 bg-base-100 rounded-box border p-5 sm:p-6"
      >
        <label
          for="search-query"
          class="text-base-content-strong mb-3 block text-sm font-semibold"
          >{t.pages.searchInputLabel}</label
        >
        <div class="flex flex-col gap-3 sm:flex-row">
          <input
            id="search-query"
            name="q"
            type="search"
            maxlength="100"
            value={query.slice(0, 100)}
            placeholder={t.pages.searchPlaceholder}
            aria-describedby="search-status"
            class="input input-bordered min-h-12 w-full min-w-0 flex-1 text-base"
          />
          <button
            id="search-submit"
            type="submit"
            class="btn btn-primary min-h-12 sm:px-7"
            >{t.pages.searchSubmit}</button
          >
        </div>
      </form>
      <p
        id="search-status"
        role="status"
        aria-live="polite"
        class="text-base-content-muted mt-5 text-sm leading-7"
      >
        {message}
      </p>
      <ul id="search-results" class="mt-3 space-y-3">
        {
          results.map(result => (
            <li class="border-base-300 bg-base-100 rounded-box border p-5 sm:p-6">
              <>
                <h3 class="text-lg leading-7 font-semibold">
                  <a
                    href={result.url}
                    class="text-primary rounded-sm hover:underline focus-visible:outline-2 focus-visible:outline-offset-4"
                  >
                    {result.title}
                  </a>
                </h3>
                <p class="text-base-content-strong mt-2 text-sm leading-7">
                  {result.description}
                </p>
              </>
            </li>
          ))
        }
      </ul>
    </section>
  </Main>
  <Footer />
</Layout>

<script>
  import {
    MAX_SEARCH_QUERY_LENGTH,
    type PublicSearchResult,
  } from "@/utils/publicSearch";

  let activeRequest: AbortController | undefined;
  function initSearch() {
    const root = document.querySelector<HTMLElement>("#live-search");
    if (!root || root.dataset.initialized) return;
    const form = root.querySelector<HTMLFormElement>("#search-form");
    const input = root.querySelector<HTMLInputElement>("#search-query");
    const button = root.querySelector<HTMLButtonElement>("#search-submit");
    const status = root.querySelector<HTMLElement>("#search-status");
    const list = root.querySelector<HTMLUListElement>("#search-results");
    if (!form || !input || !button || !status || !list) return;
    root.dataset.initialized = "true";
    let generation = 0;

    const showResults = (results: PublicSearchResult[]) => {
      list.replaceChildren();
      for (const result of results) {
        const target = new URL(result.url, location.origin);
        if (target.origin !== location.origin) continue;
        const item = document.createElement("li");
        item.className =
          "border-base-300 bg-base-100 rounded-box border p-5 sm:p-6";
        const heading = document.createElement("h3");
        heading.className = "text-lg leading-7 font-semibold";
        const link = document.createElement("a");
        link.href = target.href;
        link.className =
          "text-primary rounded-sm hover:underline focus-visible:outline-2 focus-visible:outline-offset-4";
        link.textContent = result.title;
        const description = document.createElement("p");
        description.className =
          "text-base-content-strong mt-2 text-sm leading-7";
        description.textContent = result.description;
        heading.append(link);
        item.append(heading, description);
        list.append(item);
      }
    };

    form.addEventListener("submit", async event => {
      event.preventDefault();
      const query = input.value.trim();
      const current = ++generation;
      activeRequest?.abort();
      activeRequest = new AbortController();
      button.disabled = false;
      root.setAttribute("aria-busy", "false");
      const pageUrl = new URL(location.href);
      if (query) pageUrl.searchParams.set("q", query);
      else pageUrl.searchParams.delete("q");
      history.replaceState(
        history.state,
        "",
        pageUrl.pathname + pageUrl.search
      );
      sessionStorage.setItem("backUrl", pageUrl.pathname + pageUrl.search);
      showResults([]);
      if (!query || query.length > MAX_SEARCH_QUERY_LENGTH) {
        status.textContent = query
          ? (root.dataset.tooLong ?? "")
          : (root.dataset.prompt ?? "");
        return;
      }
      button.disabled = true;
      root.setAttribute("aria-busy", "true");
      status.textContent = root.dataset.loading ?? "";
      try {
        const endpoint = new URL(root.dataset.endpoint ?? "", location.origin);
        endpoint.searchParams.set("q", query);
        endpoint.searchParams.set("lang", root.dataset.locale ?? "zh");
        const response = await fetch(endpoint, {
          signal: AbortSignal.any([
            activeRequest.signal,
            AbortSignal.timeout(10_000),
          ]),
        });
        if (!response.ok) throw new Error("SEARCH_FAILED");
        const data = (await response.json()) as {
          results: PublicSearchResult[];
        };
        // 旧查询即使晚到，也不能覆盖新关键词的结果或离开后重建的页面。
        if (current !== generation || !root.isConnected) return;
        showResults(data.results);
        status.textContent = data.results.length
          ? (root.dataset.count ?? "").replace(
              "{{n}}",
              String(data.results.length)
            )
          : (root.dataset.empty ?? "");
      } catch (error) {
        if (
          current === generation &&
          root.isConnected &&
          !(error instanceof DOMException && error.name === "AbortError")
        )
          status.textContent = root.dataset.failed ?? "";
      } finally {
        if (current === generation && root.isConnected) {
          button.disabled = false;
          root.setAttribute("aria-busy", "false");
        }
      }
    });
    input.addEventListener("input", () => {
      ++generation;
      activeRequest?.abort();
      button.disabled = false;
      root.setAttribute("aria-busy", "false");
      showResults([]);
      status.textContent = root.dataset.prompt ?? "";
    });
  }
  document.addEventListener("astro:before-swap", () => activeRequest?.abort());
  document.addEventListener("astro:page-load", initSearch);
  initSearch();
</script>
