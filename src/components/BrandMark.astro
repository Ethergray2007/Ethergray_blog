---
/**
 * 品牌标识（头像 + 站名）
 * ============================================================
 * 自包含模块：只依赖 config 和 i18n。
 *
 * 想删掉它？页眉页脚里把 <BrandMark /> 换回一行纯文字即可。
 * ============================================================
 */
import config from "@/config";
import { getAssetPath } from "@/utils/withBase";

type Props = {
  /** 尺寸档位。页眉用 md，页脚用 sm */
  size?: "sm" | "md";
  /** 是否显示站名文字。默认显示 */
  showTitle?: boolean;
  class?: string;
};

const { size = "md", showTitle = true, class: className = "" } = Astro.props;

const { site } = config;
---

<span class:list={["inline-flex items-center gap-3", className]}>
  <img
    src={getAssetPath("favicon.png")}
    alt=""
    aria-hidden="true"
    class:list={[
      "brand-avatar shrink-0 rounded-full object-cover",
      { "size-7": size === "sm", "size-8": size === "md" },
    ]}
    width={size === "sm" ? 28 : 32}
    height={size === "sm" ? 28 : 32}
  />

  {
    showTitle && (
      /*
       * brand-title 这个类名是给页眉用的钩子：首页首屏是深色海报，
       * 页眉浮在上面时站名要换成白字（见 nav.css 第十一节）。
       */
      <span class="brand-title text-base-content truncate font-semibold">
        {site.title}
      </span>
    )
  }
</span>
