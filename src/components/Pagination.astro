---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";

import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

import { useTranslations } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;

const t = useTranslations(Astro.currentLocale);
---

{
  page.lastPage > 1 && (
    <nav
      class="my-8 flex justify-center"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <div class="join">
        {page.url.prev ? (
          <a
            href={page.url.prev}
            class="btn btn-outline join-item"
            aria-label={t.a11y.goToPreviousPage}
          >
            <IconArrowLeft class="size-4 rtl:rotate-180" />
            <span class="hidden sm:inline">
              {t.pagination.prev}
            </span>
          </a>
        ) : (
          <span
            class="btn btn-outline join-item btn-disabled"
            aria-disabled="true"
          >
            <IconArrowLeft class="size-4 rtl:rotate-180" />
            <span class="hidden sm:inline">
              {t.pagination.prev}
            </span>
          </span>
        )}

        <span class="btn join-item no-animation">
          {page.currentPage} / {page.lastPage}
        </span>

        {page.url.next ? (
          <a
            href={page.url.next}
            class="btn btn-outline join-item"
            aria-label={t.a11y.goToNextPage}
          >
            <span class="hidden sm:inline">
              {t.pagination.next}
            </span>
            <IconArrowRight class="size-4 rtl:rotate-180" />
          </a>
        ) : (
          <span
            class="btn btn-outline join-item btn-disabled"
            aria-disabled="true"
          >
            <span class="hidden sm:inline">
              {t.pagination.next}
            </span>
            <IconArrowRight class="size-4 rtl:rotate-180" />
          </span>
        )}
      </div>
    </nav>
  )
}