---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";

import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, tags, ...props } = data;

const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
---

<li class="my-4 list-none">
  <article
    class="card card-border bg-base-100 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md"
  >
    <div class="card-body gap-4 p-4 sm:p-6">
      <!-- Title -->
      <div>
        <a href={postUrl} class="group inline-block w-full" aria-label={title}>
          <Heading
            class="card-title text-base-content group-hover:text-primary text-lg leading-snug tracking-tight transition-colors sm:text-xl"
            transition:name={toTransitionName(title)}
          >
            {title}
          </Heading>
        </a>
      </div>

      <!-- Metadata -->
      <div class="flex items-center">
        <Datetime {...props} />
      </div>

      <!-- Description -->
      {
        description && (
          <p class="text-base-content/65 line-clamp-3 text-sm leading-7 sm:text-base">
            {description}
          </p>
        )
      }

      <!-- Tags -->
      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-1">
            {tags.slice(0, 4).map(tag => (
              <a
                href={getRelativeLocaleUrl(
                  Astro.currentLocale ?? "zh",
                  `tags/${slugifyStr(tag)}`
                )}
                class="badge badge-outline badge-sm hover:badge-primary transition-colors"
              >
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </article>
</li>
