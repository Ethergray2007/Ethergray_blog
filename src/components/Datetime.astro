---
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const timeZone = postTimezone ?? config.site.timezone;

const pubDate = new Date(pubDatetime);
const modDate = modDatetime ? new Date(modDatetime) : null;
const isModified = Boolean(modDate && modDate.getTime() > pubDate.getTime());
const targetDate = isModified && modDate ? modDate : pubDate;

/**
 * 使用运行时内置的 Intl.DateTimeFormat 替代 dayjs，零第三方依赖且完整支持 IANA 时区：
 *   zh → 2026年9月25日
 *   en → 25 Sep, 2026
 */
function formatDate(date: Date): string {
  if (locale === "zh") {
    const parts = new Intl.DateTimeFormat("zh-CN", {
      timeZone,
      year: "numeric",
      month: "numeric",
      day: "numeric",
    }).formatToParts(date);
    const get = (type: string) =>
      parts.find(part => part.type === type)?.value ?? "";
    return `${get("year")}年${get("month")}月${get("day")}日`;
  }

  const parts = new Intl.DateTimeFormat("en-GB", {
    timeZone,
    day: "numeric",
    month: "short",
    year: "numeric",
  }).formatToParts(date);
  const get = (type: string) =>
    parts.find(part => part.type === type)?.value ?? "";
  return `${get("day")} ${get("month")}, ${get("year")}`;
}

const date = formatDate(targetDate);
---

<div class:list={[className]}>
  <!-- 日期只是阅读辅助信息，去掉徽章外观，避免被误认为可点击的标签。 -->
  <time
    class:list={[
      "text-base-content-muted inline-flex flex-wrap items-center gap-x-2 gap-y-1 leading-6",
      {
        "text-sm": size === "sm",
        "text-base": size === "lg",
      },
    ]}
    datetime={targetDate.toISOString()}
  >
    <IconCalendar
      class:list={["size-4 shrink-0", { "size-5": size === "lg" }]}
      aria-hidden="true"
    />

    {isModified && <span>{t.post.updatedAt}:</span>}

    <span>{date}</span>
  </time>
</div>
