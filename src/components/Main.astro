---
/**
 * 页面外壳（列表页 / 内容页共用）
 * ============================================================
 * 提供：页面标题（h1）+ 标题下的渐变线 + 可选说明 + 顶部极光射线。
 *
 * 【为什么顶部射线接在这里，而不是每个页面各接一次】
 * 全站有 9 个页面用这个组件（文章列表、标签、归档、说说、项目、
 * 友链、近况、关于、搜索）。接在这里等于一次覆盖全部，
 * 而且每个页面里不用多写一行 import —— 符合"接入页面最多 2 行"的约定。
 * （首页不用它：首页有自己的首屏，见 index.astro。)
 * ============================================================
 */
import PageGlow from "./PageGlow.astro";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
};

const { pageTitle, pageDesc, class: className } = Astro.props;
---

<main
  id="main-content"
  class:list={["content-shell py-8 sm:py-10 lg:py-12", className]}
>
  {
    /*
    极光射线（样式见 src/styles/page-glow.css）。

    ⚠️ 它必须放在这里、而且在 header **之前**：
      · 外层 div 是 relative，给射线当定位参照物，
        同时用 overflow-hidden 把超出容器的部分裁掉 ——
        少了它射线会顶出横向滚动条
      · 放在 header 前面是为了让它铺在标题后面（DOM 顺序决定
        同层级的绘制顺序），而不是盖在标题上

    盖住标题不会影响可读性：射线在浅色模式下是 30% 透明度的
    反相条纹、深色模式 50%，压在文字上的那部分几乎看不出来。
  */
  }
  <div class="relative overflow-hidden">
    <PageGlow />

    <header class="relative mb-8 sm:mb-10">
      <h1 class="page-heading">
        {pageTitle}
      </h1>

      {
        /*
        标题下那条渐变小横线（样式见 global.css 的 page-heading-rule）。
        aria-hidden 是必须的：它纯装饰，读屏软件念出来只会打断标题。
      */
      }
      <span class="page-heading-rule" aria-hidden="true"></span>

      {
        pageDesc && (
          <p class="text-base-content-muted mt-5 max-w-2xl text-sm leading-7 sm:text-lg">
            {pageDesc}
          </p>
        )
      }
    </header>
  </div>

  <slot />
</main>
