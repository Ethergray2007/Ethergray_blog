---
import { getRelativeLocaleUrl } from "astro:i18n";

import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  /**
   * 这个标签下有几篇文章。不传就不显示。
   * 做成可选是为了向后兼容 —— 文章页用 <Tag> 时不需要数量。
   */
  count?: number;
};

const { tag, tagName, size = "lg", count } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "group border-base-300 bg-base-100 text-base-content hover:border-primary/50 hover:bg-primary/5 hover:text-primary inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm font-medium transition-colors duration-200",
      {
        "text-xs": size === "sm",
        "text-sm": size === "lg",
      },
    ]}
  >
    <IconHash
      class:list={[
        "text-primary/80 group-hover:text-primary transition-colors",
        {
          "size-3": size === "sm",
          "size-4": size === "lg",
        },
      ]}
    />

    <span>{tagName}</span>

    {
      count !== undefined && (
        <span class="text-base-content-muted group-hover:text-primary ms-0.5 tabular-nums transition-colors">
          {count}
        </span>
      )
    }
  </a>
</li>
