---
import { getRelativeLocaleUrl } from "astro:i18n";

import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const {
  tag,
  tagName,
  size = "lg",
} = Astro.props;

const locale =
  Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(
      locale,
      `tags/${tag}/`
    )}
    transition:name={tag}
    class:list={[
      "badge badge-outline gap-1 transition-colors hover:badge-primary",
      {
        "badge-sm": size === "sm",
        "badge-lg": size === "lg",
      },
    ]}
  >
    <IconHash
      class:list={[
        {
          "size-3": size === "sm",
          "size-4": size === "lg",
        },
      ]}
    />

    {tagName}
  </a>
</li>