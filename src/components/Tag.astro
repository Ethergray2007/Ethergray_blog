---
import { getRelativeLocaleUrl } from "astro:i18n";

import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  /**
   * 这个标签下有几篇文章。不传就不显示。
   * 做成可选是为了向后兼容 —— 文章页用 <Tag> 时不需要数量。
   */
  count?: number;
};

const { tag, tagName, size = "lg", count } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "badge badge-outline hover:badge-primary gap-1 transition-colors",
      {
        "badge-sm": size === "sm",
        "badge-lg": size === "lg",
      },
    ]}
  >
    <IconHash
      class:list={[
        {
          "size-3": size === "sm",
          "size-4": size === "lg",
        },
      ]}
    />

    {tagName}

    {
      count !== undefined && (
        <span class="text-base-content/50 ms-0.5 tabular-nums">{count}</span>
      )
    }
  </a>
</li>
