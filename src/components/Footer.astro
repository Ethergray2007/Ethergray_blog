---
import type { HTMLAttributes } from "astro/types";

import Socials from "./Socials.astro";
import config from "@/config";
import { tplStr, useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();

// 版权行在语言文件里拼好，避免模板里多个表达式相邻把空格吃掉
// （否则会渲染成 “© 2026Ethergray”）。
const copyrightLine = tplStr(t.footer.copyrightLine, {
  year: String(currentYear),
  author: config.site.author,
});
---

<footer
  class:list={[
    "border-base-300 bg-base-100 border-t",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div
    class="site-shell flex flex-col items-center gap-4 py-6 sm:flex-row sm:justify-between sm:py-8"
  >
    <!-- Copyright -->
    <div class="text-base-content/60 text-center text-sm sm:text-left">
      <p>
        {copyrightLine}
      </p>

      <p class="mt-1">
        {t.footer.allRightsReserved}
      </p>
    </div>

    <!-- Social links -->
    <div class="flex items-center">
      <Socials />
    </div>
  </div>
</footer>
