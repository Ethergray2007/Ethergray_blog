---
/**
 * 页眉（吸顶导航）
 * ============================================================
 * 自包含模块：只依赖 BrandMark、i18n、config。
 *
 * 想删掉某个部件？
 *   · 品牌标识   → 把 <BrandMark /> 换回一行纯文字
 *   · 搜索入口   → config 里 features.search 改成 false
 *   · 主题开关   → config 里 features.lightAndDarkMode 改成 false
 *   · 整个吸顶玻璃 → 见 src/styles/nav.css 的文件头
 *
 * ------------------------------------------------------------
 * 【改版前的问题，以及这次怎么改的】
 *
 *   1. 最左边是**光秃秃的文字**链接（"Ethergray Blog"）。
 *      浏览器里就是一段字，没有任何图形锚点。参考站的做法是
 *      「图形标识 + 文字的 lockup」，人对图形的识别是瞬间的，
 *      对文字要先读一遍。现在用 BrandMark（渐变方块 + 首字母）。
 *
 *   2. 搜索只有**一个放大镜图标**，读者要猜它是什么。
 *      参考站的 .DocSearch-Button 是「放大镜 + 占位文字 + kbd 键帽」，
 *      自己说明了用途，还多一个键盘入口。现在照这个做，
 *      并且真的把 `/` 键绑上了（只画键帽不让它生效是骗人的）。
 *
 *   3. 主题开关是个**图标按钮**，只能表达"现在是什么"，
 *      表达不了"这是一个可以拨的开关"。现在换成胶囊滑块
 *      （参考站的 .VPSwitch），语义也改成 role="switch" +
 *      aria-checked —— 读屏软件会念"开关，已打开/已关闭"。
 *
 *   4. 内容链接和工具按钮**混成一片**，没有分隔。
 *      现在中间加一条 1px × 24px 竖线（参考站也是这么分的）。
 *
 *   5. 桌面导航和移动端抽屉**各写了一遍**那四个链接，
 *      加一个页面要改两个地方、漏一处没人发现。
 *      现在共用一份 navItems（见下面），渲染两遍。
 * ============================================================
 */
import { getRelativeLocaleUrl } from "astro:i18n";

import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconChevronDown from "@/assets/icons/IconChevronDown.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";

import BrandMark from "./BrandMark.astro";

import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

// 站名不在这里取了 —— 页眉里那个标题由 BrandMark 渲染（它自己读 config）。
const { features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);

const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

/**
 * 顶部导航的四个内容链接。
 *
 * 写成数组是因为下面要渲染**两遍**：桌面横排一遍、移动端抽屉一遍。
 * 改版前这两处各写了一遍，四个链接就是八段几乎一样的标记。
 *
 * 顺序就是显示顺序。
 */
const navItems = [
  { path: "/posts", label: t.nav.posts },
  { path: "/friends", label: t.nav.friends },
  { path: "/notes", label: t.nav.notes },
  { path: "/projects", label: t.nav.projects },
];

/**
 * 「更多」菜单里的辅助页面。
 *
 * 【为什么这几个从页脚搬了上来】
 * 它们原来和订阅源（RSS/Atom/Sitemap）一起挤在页脚的一行里，共七个链接。
 * 页脚是"收尾"，塞七个链接就变成了"第二个导航区"——扫视成本高；
 * 而真正想找它们的人是在**找入口**，抬头看页眉才是第一反应。
 *
 * 搬进「更多」之后页脚只剩品牌标识和版权。桌面端渲染成下拉菜单、
 * 移动端进抽屉，两边共用这一份数组 —— 和 navItems 同一个理由：
 * 加一个入口只改一处。
 *
 * 归档页可以被 config 关掉，所以它是有条件的。
 */
const moreItems = [
  { path: "/tags", label: t.nav.tags },
  ...(features.showArchives !== false
    ? [{ path: "/archives", label: t.nav.archives }]
    : []),
  { path: "/now", label: t.nav.now },
  { path: "/about", label: t.nav.about },
];

/**
 * 当前页是不是「更多」里的某一页（比如正在看 /tags）。
 * 是的话，触发按钮也要亮起来 —— 否则页眉上没有任何地方指示当前位置。
 */
const isMoreActive = moreItems.some(item => isActive(item.path));

/**
 * 服务端渲染时拿不到用户的主题偏好（它存在 localStorage 里），
 * 所以这里先给一个初始值；`src/scripts/theme.ts` 会在客户端把
 * `aria-checked` 同步成真实状态，保证读屏软件读到的是对的。
 */
const isDarkInitially = false;

const searchHref = getRelativeLocaleUrl(locale, "search");
---

<a
  id="skip-to-content"
  href="#main-content"
  class="btn btn-sm btn-ghost bg-base-100 text-primary absolute inset-s-4 -top-full z-50 shadow-md focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header id="site-header">
  {
    /*
    ⚠️ `site-shell` 挂在内层的 .nav-grid 上，**不是**挂在 header 上。

    挂在 header 上的话，玻璃条底色和那条底边会被限成 max-w-7xl、
    左右还各留 32px —— 看起来是"页面中间悬着一条"，而页眉本该通栏。
    现在的分工是：

      header / .nav-glass     通栏：底色、底边、顶部亮线都铺满视口
      .nav-grid + site-shell  内容限宽，和正文左右对齐

    这样"条铺满、字对齐"两个要求同时成立。

    ⚠️ 三栏用 grid 而不是 flex + justify-between：
      左 auto / 中 minmax(0,1fr) / 右 auto
    左右两栏按内容宽固定，只有中间那栏伸缩 ——
    导航项增减时右边那组按钮纹丝不动。
    用 flex 挤开的话，加一个导航项就会把工具组推着走。
  */
  }
  <div class="nav-glass border-base-300 border-b">
    <div class="nav-grid site-shell">
      <!-- Logo -->
      <div class="flex min-w-0 items-center">
        {
          /*
          ⚠️ group 类挂在 <a> 上，配合 nav.css 里的
          `.group:hover .brand-bar` 实现"悬停时竖条长高"。
          缺了 group，那个动效不会触发。
        */
        }
        <a
          href={getRelativeLocaleUrl(locale, "")}
          class="group flex items-center gap-2.5 rounded-lg py-1.5 ps-1 pe-2 transition-opacity hover:opacity-90"
        >
          <span class="brand-bar" aria-hidden="true"></span>

          <BrandMark />
        </a>
      </div>

      <!-- Desktop navigation（居中） -->
      <nav
        class="hidden min-w-0 justify-center md:flex"
        aria-label="Primary navigation"
      >
        <ul class="flex items-center gap-0.5">
          {
            navItems.map(item => (
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, item.path.slice(1))}
                  class="nav-link"
                  aria-current={isActive(item.path) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }

          {
            /*
              「更多」下拉。

              ⚠️ 用 <details>/<summary> 而不是自己写 JS 开关：
              键盘操作（Enter/Space 展开）、展开状态语义都由浏览器给，
              我们少维护一段脚本。样式复用 daisyUI 的 dropdown + menu。
            */
          }
          <li>
            <details class="dropdown dropdown-end dropdown-bottom nav-more">
              <summary
                class="nav-link"
                data-current={isMoreActive ? "true" : undefined}
              >
                {t.nav.more}
                <IconChevronDown class="nav-more__caret size-3.5 shrink-0" />
              </summary>

              <ul
                class="menu dropdown-content bg-base-100 border-base-300 rounded-box mt-2 w-40 border p-1.5 shadow-lg"
              >
                {
                  moreItems.map(item => (
                    <li>
                      <a
                        href={getRelativeLocaleUrl(locale, item.path.slice(1))}
                        aria-current={isActive(item.path) ? "page" : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
          </li>
        </ul>
      </nav>

      <!-- 右侧：搜索 + 主题 + 汉堡，统一收进一个玻璃小容器 -->
      <div class="flex items-center justify-end">
        <div class="nav-tools">
          <!-- Search -->
          {
            features.search !== false && (
              <a
                href={searchHref}
                class="nav-search"
                aria-keyshortcuts="/"
                title={t.a11y.searchPlaceholder}
              >
                <IconSearch class="size-4 shrink-0" />

                <span class="nav-search__label">{t.nav.search}</span>

                {/*
                  kbd 里那个「/」是**快捷键提示**，不是装饰。
                  对应的 keydown 处理在下面那段脚本里 ——
                  只画一个键帽却不让它生效，是骗人的。
                  窄屏下它会被 CSS 隐藏（见 nav.css 的 64rem 断点）。
                */}
                <kbd>/</kbd>
              </a>
            )
          }

          <!-- Theme -->
          {
            features.lightAndDarkMode && (
              <button
                id="theme-btn"
                type="button"
                role="switch"
                class="theme-switch mx-1"
                title={t.a11y.toggleTheme}
                aria-label={t.a11y.toggleTheme}
                aria-checked={isDarkInitially}
              >
                <IconSunHigh class="theme-switch__icon theme-switch__icon--sun" />
                <IconMoon class="theme-switch__icon theme-switch__icon--moon" />
              </button>
            )
          }

          <!-- Mobile menu button -->
          <button
            type="button"
            class="nav-icon-btn nav-mobile-only"
            aria-label={t.a11y.openMenu}
            aria-controls="mobile-menu"
            data-mobile-menu-open
          >
            <IconMenuDeep class="size-5" />
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Mobile navigation -->
<dialog id="mobile-menu" class="modal md:hidden">
  <div
    class="modal-box absolute inset-y-0 inset-e-0 m-0 flex w-80 max-w-[85vw] flex-col rounded-none p-0"
  >
    <!-- Drawer header -->
    <div
      class="border-base-300 flex min-h-16 shrink-0 items-center justify-between border-b px-4"
    >
      <BrandMark size="sm" />

      <form method="dialog">
        <button
          type="submit"
          class="nav-icon-btn"
          aria-label={t.a11y.closeMenu}
        >
          <IconX class="size-5" />
        </button>
      </form>
    </div>

    <!-- Navigation -->
    <nav class="flex-1 overflow-y-auto p-4" aria-label="Mobile navigation">
      <ul class="menu w-full gap-1">
        {
          navItems.map(item => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, item.path.slice(1))}
                aria-current={isActive(item.path) ? "page" : undefined}
                data-mobile-menu-link
              >
                {item.label}
              </a>
            </li>
          ))
        }

        <!-- 「更多」里的辅助页面（桌面端在下拉菜单里） -->
        <li class="menu-title">{t.nav.more}</li>

        {
          moreItems.map(item => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, item.path.slice(1))}
                aria-current={isActive(item.path) ? "page" : undefined}
                data-mobile-menu-link
              >
                {item.label}
              </a>
            </li>
          ))
        }

        <!-- Search -->
        {
          features.search !== false && (
            <li>
              <a
                href={searchHref}
                aria-current={isActive("/search") ? "page" : undefined}
                data-mobile-menu-link
              >
                <IconSearch class="size-5" />
                {t.nav.search}
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>

  <!-- Backdrop -->
  <form method="dialog" class="modal-backdrop">
    <button aria-label={t.a11y.closeMenu}></button>
  </form>
</dialog>

<script>
  /**
   * 跨页面切换保持的全局回调（见文件末尾 initHeaderScrollState 的说明）。
   * 声明在这里是因为 TS 不知道我们往 window 上挂了东西。
   */
  declare global {
    interface Window {
      __navScrollSync?: () => void;
    }
  }

  function initMobileMenu() {
    const dialog = document.querySelector<HTMLDialogElement>("#mobile-menu");

    const openButton = document.querySelector<HTMLButtonElement>(
      "[data-mobile-menu-open]"
    );

    const links = document.querySelectorAll<HTMLAnchorElement>(
      "[data-mobile-menu-link]"
    );

    if (!dialog || !openButton) return;

    if (!openButton.dataset.initialized) {
      openButton.dataset.initialized = "true";

      openButton.addEventListener("click", () => {
        if (!dialog.open) {
          dialog.showModal();
        }
      });
    }

    links.forEach(link => {
      if (link.dataset.initialized) return;

      link.dataset.initialized = "true";

      link.addEventListener("click", () => {
        if (dialog.open) {
          dialog.close();
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initMobileMenu);
  initMobileMenu();

  /**
   * 搜索快捷键：按 `/` 跳到搜索页。
   *
   * 【为什么真的要让这个键生效】
   * 页眉里画了一个写着「/」的键帽（kbd）。按下去没反应的话，
   * 那个提示就是在骗人 —— 要么别画，要么让它工作。
   *
   * 【几条必须排除的情况，少一条都会让人抓狂】
   *   · 正在输入框里打字（后台的编辑器、搜索页自己的输入框）
   *   · 按了修饰键（Ctrl+/ 是别的功能，不该被抢）
   *   · 移动端抽屉正开着
   *
   * 判断输入框用 tagName + isContentEditable，**两个都要** ——
   * 富文本编辑器是 contenteditable，不是 input/textarea。
   */
  function initSearchShortcut() {
    if (document.documentElement.dataset.searchKeyBound === "true") {
      return;
    }

    if (!document.querySelector(".nav-search")) return;

    document.documentElement.dataset.searchKeyBound = "true";

    document.addEventListener("keydown", event => {
      if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) {
        return;
      }

      const target = event.target as HTMLElement | null;

      if (
        target &&
        (target.isContentEditable ||
          /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))
      ) {
        return;
      }

      // 移动端抽屉开着的时候不抢键
      if (document.querySelector("#mobile-menu[open]")) {
        return;
      }

      const link = document.querySelector<HTMLAnchorElement>(".nav-search");

      if (!link) return;

      event.preventDefault();
      window.location.href = link.href;
    });
  }

  document.addEventListener("astro:page-load", initSearchShortcut);
  initSearchShortcut();

  /**
   * 吸顶导航的滚动状态（样式见 src/styles/nav.css）。
   *
   * 【为什么用 data-scrolled 属性，而不是在 JS 里直接改样式】
   * 让 JS 只负责"判断状态"，颜色交给 CSS ——
   * 这样浅色/深色两套值仍然写在 CSS 里，JS 不需要知道主题。
   * 如果在这里写 style.boxShadow，主题一变就得再来问一次 JS。
   *
   * 【为什么挂在 document 上、而且要 prevent 重复绑定】
   * ClientRouter 切换页面时 header 是新的 DOM，但 document 还是同一个。
   * 不标记的话每切一次页面就多一个 scroll 监听，切十次就有十个 ——
   * 表现是滚动开始变卡，而且很难联想到原因。
   */
  function initHeaderScrollState() {
    const header = document.querySelector<HTMLElement>("#site-header");

    if (!header) return;

    const sync = () => {
      header.dataset.scrolled = window.scrollY > 8 ? "true" : "false";
    };

    sync();

    if (document.documentElement.dataset.navScrollBound === "true") {
      /*
       * 已经绑过了，只更新一次状态就返回。
       * 把最新的 header 元素交给全局的那一个监听器 ——
       * 否则它还在更新被换掉的那个旧节点（等于失效）。
       */
      window.__navScrollSync = sync;
      return;
    }

    document.documentElement.dataset.navScrollBound = "true";
    window.__navScrollSync = sync;

    window.addEventListener("scroll", () => window.__navScrollSync?.(), {
      passive: true,
    });
  }

  document.addEventListener("astro:page-load", initHeaderScrollState);
  initHeaderScrollState();
</script>
