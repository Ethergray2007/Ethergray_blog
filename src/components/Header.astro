---
import { getRelativeLocaleUrl } from "astro:i18n";

import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";

import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);

const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

/**
 * 服务端渲染时拿不到用户的主题偏好（它存在 localStorage 里），
 * 所以这里先给一个初始值；`src/scripts/theme.ts` 会在客户端把
 * `aria-pressed` 同步成真实状态，保证读屏软件读到的是对的。
 */
const isDarkInitially = false;
---

<a
  id="skip-to-content"
  href="#main-content"
  class="btn btn-sm btn-ghost bg-base-100 text-primary absolute inset-s-4 -top-full z-50 shadow-md focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="site-shell">
  <div
    class="navbar border-base-300 bg-base-100 min-h-16 border-b px-0 sm:min-h-20"
  >
    <!-- Logo -->
    <div class="navbar-start min-w-0">
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class="btn btn-ghost min-h-0 max-w-full px-2 text-lg font-semibold sm:text-2xl"
      >
        <span class="truncate">{site.title}</span>
      </a>
    </div>

    <div class="navbar-end gap-1">
      <!-- Desktop navigation -->
      <nav class="hidden sm:block" aria-label="Primary navigation">
        <ul class="menu menu-horizontal items-center gap-1 px-1">
          <!-- Posts -->
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "posts")}
              class:list={[
                "font-medium",
                { "menu-active": isActive("/posts") },
              ]}
              aria-current={isActive("/posts") ? "page" : undefined}
            >
              {t.nav.posts}
            </a>
          </li>

          <!-- Friends -->
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "friends")}
              class:list={[
                "font-medium",
                { "menu-active": isActive("/friends") },
              ]}
              aria-current={isActive("/friends") ? "page" : undefined}
            >
              {t.nav.friends}
            </a>
          </li>

          <!-- Notes -->
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "notes")}
              class:list={[
                "font-medium",
                { "menu-active": isActive("/notes") },
              ]}
              aria-current={isActive("/notes") ? "page" : undefined}
            >
              {t.nav.notes}
            </a>
          </li>

          <!-- Projects -->
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "projects")}
              class:list={[
                "font-medium",
                { "menu-active": isActive("/projects") },
              ]}
              aria-current={isActive("/projects") ? "page" : undefined}
            >
              {t.nav.projects}
            </a>
          </li>

          {
            /*
            ============================================================
            这里原本还有「标签」「关于」「近况」三个文字链接，
            以及一个「归档」图标按钮，现在都去掉了。

            判断依据：那 7 个链接不是同一类东西 ——
              内容类型（站点主体）    文章 说说 项目 友链
              辅助页面（只看一次）    关于 近况 标签 归档

            后者移到页脚（见 Footer.astro）。理由：
              · 顶部是导航，作用是"去哪"，不是"全部入口的清单"
              · 页脚本来就有空间（原来只有版权 + 社交图标），
                而且"关于""归档"这类链接放页脚是通行做法
              · 顶部从 10 个可点元素降到 6 个

            ⚠️ 那三个页面本身没有被删，只是入口换了位置。
            直接访问 /about、/now、/tags、/archives 仍然正常。
            ============================================================
          */
          }

          <!-- Search -->
          {
            features.search !== false && (
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, "search")}
                  class:list={{
                    "menu-active": isActive("/search"),
                  }}
                  class="btn btn-ghost btn-square"
                  title={t.nav.search}
                  aria-label={t.nav.search}
                >
                  <IconSearch class="size-5" />
                </a>
              </li>
            )
          }
        </ul>
      </nav>

      <!-- Theme -->
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            type="button"
            class="btn btn-ghost btn-square"
            title={t.a11y.toggleTheme}
            aria-label={t.a11y.toggleTheme}
            aria-pressed={isDarkInitially}
          >
            <span class="relative grid size-5 place-items-center">
              <IconMoon class="absolute size-5 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
              <IconSunHigh class="absolute size-5 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
            </span>
          </button>
        )
      }

      <!-- Mobile menu button -->
      <button
        type="button"
        class="btn btn-ghost btn-square sm:hidden"
        aria-label={t.a11y.openMenu}
        aria-controls="mobile-menu"
        data-mobile-menu-open
      >
        <IconMenuDeep class="size-6" />
      </button>
    </div>
  </div>
</header>

<!-- Mobile navigation -->
<dialog id="mobile-menu" class="modal sm:hidden">
  <div
    class="modal-box absolute inset-y-0 inset-e-0 m-0 flex w-80 max-w-[85vw] flex-col rounded-none p-0"
  >
    <!-- Drawer header -->
    <div
      class="border-base-300 flex min-h-16 shrink-0 items-center justify-between border-b px-4"
    >
      <span class="truncate text-lg font-semibold">
        {site.title}
      </span>

      <form method="dialog">
        <button
          type="submit"
          class="btn btn-ghost btn-square"
          aria-label={t.a11y.closeMenu}
        >
          <IconX class="size-6" />
        </button>
      </form>
    </div>

    <!-- Navigation -->
    <nav class="flex-1 overflow-y-auto p-4" aria-label="Mobile navigation">
      <ul class="menu w-full gap-1">
        <!-- Posts -->
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={{
              "menu-active": isActive("/posts"),
            }}
            data-mobile-menu-link
          >
            {t.nav.posts}
          </a>
        </li>

        <!-- Friends -->
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "friends")}
            class:list={{
              "menu-active": isActive("/friends"),
            }}
            data-mobile-menu-link
          >
            {t.nav.friends}
          </a>
        </li>

        <!-- Notes -->
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "notes")}
            class:list={{
              "menu-active": isActive("/notes"),
            }}
            data-mobile-menu-link
          >
            {t.nav.notes}
          </a>
        </li>

        <!-- Projects -->
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "projects")}
            class:list={{
              "menu-active": isActive("/projects"),
            }}
            data-mobile-menu-link
          >
            {t.nav.projects}
          </a>
        </li>

        {
          /*
          这里原本还有「标签」「关于」「近况」「归档」四项。
          它们移到了页脚 —— 理由见桌面端导航那段注释。
        */
        }

        <!-- Search -->
        {
          features.search !== false && (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, "search")}
                class:list={{
                  "menu-active": isActive("/search"),
                }}
                data-mobile-menu-link
              >
                <IconSearch class="size-5" />
                {t.nav.search}
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>

  <!-- Backdrop -->
  <form method="dialog" class="modal-backdrop">
    <button aria-label={t.a11y.closeMenu}></button>
  </form>
</dialog>

<script>
  function initMobileMenu() {
    const dialog = document.querySelector<HTMLDialogElement>("#mobile-menu");

    const openButton = document.querySelector<HTMLButtonElement>(
      "[data-mobile-menu-open]"
    );

    const links = document.querySelectorAll<HTMLAnchorElement>(
      "[data-mobile-menu-link]"
    );

    if (!dialog || !openButton) return;

    if (!openButton.dataset.initialized) {
      openButton.dataset.initialized = "true";

      openButton.addEventListener("click", () => {
        if (!dialog.open) {
          dialog.showModal();
        }
      });
    }

    links.forEach(link => {
      if (link.dataset.initialized) return;

      link.dataset.initialized = "true";

      link.addEventListener("click", () => {
        if (dialog.open) {
          dialog.close();
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initMobileMenu);
  initMobileMenu();
</script>
